<style>
    .cp-page {
        max-width: 1100px;
    }

    .cp-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 1.25rem;
    }

        .cp-header h1 {
            font-size: 22px;
            font-weight: 600;
            color: var(--g-navy);
            margin: 0 0 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .cp-header h1 i {
                color: var(--g-teal);
                font-size: 22px;
            }

        .cp-header p {
            font-size: 14px;
            color: var(--g-muted);
            margin: 0;
        }

    .cp-volver {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 500;
        color: var(--g-muted);
        text-decoration: none;
        margin-bottom: 8px;
        padding: 4px 0;
    }

        .cp-volver:hover {
            color: var(--g-teal);
        }

    .btn-g-primary,
    .btn-g-outline,
    .btn-g-danger {
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: background var(--transition), color var(--transition), border-color var(--transition);
    }

    .btn-g-primary {
        background: var(--g-teal);
        color: #FFFFFF;
        border: 1px solid var(--g-teal);
    }

        .btn-g-primary:hover {
            background: #065F46;
            border-color: #065F46;
            color: #FFFFFF;
        }

        .btn-g-primary:disabled {
            cursor: wait;
        }

    .btn-g-outline {
        background: var(--g-white);
        color: var(--g-navy);
        border: 1px solid var(--g-input-border);
    }

        .btn-g-outline:hover {
            border-color: var(--g-teal);
            color: var(--g-teal);
        }

    .btn-g-danger {
        background: var(--g-danger-text);
        color: #FFFFFF;
        border: 1px solid var(--g-danger-text);
    }

        .btn-g-danger:hover {
            background: #991B1B;
            border-color: #991B1B;
        }

    .btn-g-primary:focus-visible,
    .btn-g-outline:focus-visible,
    .btn-g-danger:focus-visible,
    .cp-volver:focus-visible {
        outline: 2px solid var(--g-teal);
        outline-offset: 2px;
    }

    .cp-aviso {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 8px 10px 14px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 1rem;
    }

        .cp-aviso.exito {
            background: rgba(4,120,87,0.1);
            border: 1px solid rgba(4,120,87,0.25);
            color: var(--g-teal);
        }

        .cp-aviso.error {
            background: rgba(220,38,38,0.08);
            border: 1px solid rgba(220,38,38,0.3);
            color: var(--g-danger-text);
        }

        .cp-aviso span {
            flex: 1;
        }

        .cp-aviso button {
            background: none;
            border: none;
            color: inherit;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .cp-aviso button:hover {
                background: rgba(15,23,42,0.06);
            }

            .cp-aviso button:focus-visible {
                outline: 2px solid currentColor;
                outline-offset: 1px;
            }

    .cp-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #FFFFFF;
        border-radius: 50%;
        animation: cp-girar 0.7s linear infinite;
    }

    @@keyframes cp-girar {
        to { transform: rotate(360deg); }
    }
</style>
