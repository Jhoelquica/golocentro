@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Golocentro</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            /* =============================================
               VARIABLES — Paleta Golocentro v2 (Inventory & Stock Management)
               Migrado desde navy/teal/sage/cream. Nombres de variable conservados
               por compatibilidad (usados en ~90 sitios), pero ahora mapean a la
               paleta slate + verde stock. Contraste verificado contra WCAG AA
               (4.5:1 texto normal) para cada par fondo/texto real del archivo.
            ============================================= */
            :root {
                --g-navy:   #334155;   /* antes #001F36 — fondo sidebar, texto oscuro sobre blanco */
                --g-teal:   #047857;   /* antes #1C5560 — acento/verde stock, ajustado a 5.48:1 (el #059669 "puro" del design system falla AA con texto blanco encima) */
                --g-sage:   #CBD5E1;   /* antes #79AE92 — texto secundario sobre fondo oscuro, 6.97:1 */
                --g-cream:  #FFFFFF;   /* antes #FBFFCD — texto de alto énfasis sobre sidebar/acento */
                --g-white:  #FFFFFF;   /* sin cambio — superficies/tarjetas */
                --g-bg:     #F8FAFC;   /* antes #F0F4F7 — fondo de página */
                --g-border: #E6E8EA;   /* antes rgba(121,174,146,0.2) — ahora sólido */
                --g-text:   #0F172A;   /* antes #001F36 — texto de cuerpo */
                --g-muted:  #475569;   /* antes #5a7d6e — texto secundario sobre blanco, 7.58:1 */
                --g-danger: #DC2626;   /* nuevo — unifica los rojos sueltos (#e74c3c/#c0392b) que había antes */
                --g-danger-text: #B91C1C;  /* texto rojo sobre fondo rosado: 5.5:1 (#DC2626 ahí solo da 4.1:1) */
                --g-input-border: #8492A6; /* borde de campos: 3.2:1 contra blanco (WCAG 1.4.11) */
                --g-focus-dark: #6EE7B7;   /* anillo de foco sobre fondos slate oscuros: 6.8:1 */
                --sidebar-w: 230px;
                --topbar-h:  62px;
                --radius:    10px;
                --transition: 0.18s ease;
            }

            * { box-sizing: border-box; margin: 0; padding: 0; }

            body {
                font-family: 'Inter', sans-serif;
                background: var(--g-bg);
                color: var(--g-text);
                min-height: 100vh;
            }

            /* =============================================
               SIDEBAR
            ============================================= */
            .g-sidebar {
                position: fixed;
                top: 0; left: 0;
                width: var(--sidebar-w);
                height: 100vh;
                background: var(--g-navy);
                display: flex;
                flex-direction: column;
                z-index: 1000;
                transition: transform var(--transition);
            }

            /* Brand */
            .g-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 1.25rem 1.2rem;
                border-bottom: 1px solid rgba(255,255,255,0.12);
                text-decoration: none;
            }
            .g-brand-icon {
                width: 38px; height: 38px;
                background: var(--g-teal);
                border-radius: 10px;
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
            }
            .g-brand-icon i { font-size: 20px; color: var(--g-cream); }
            .g-brand-text { line-height: 1.2; }
            .g-brand-name {
                font-size: 15px; font-weight: 600;
                color: var(--g-cream); display: block;
            }
            .g-brand-sub {
                font-size: 10px; color: var(--g-sage);
                letter-spacing: 0.05em;
            }

            /* Nav items */
            .g-nav { padding: 1rem 0.75rem; flex: 1; overflow-y: auto; }

            .g-nav-section {
                font-size: 10px; font-weight: 600;
                color: var(--g-sage);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0.6rem 0.6rem 0.3rem;
                margin-top: 0.5rem;
            }

            .g-nav-link {
                display: flex; align-items: center; gap: 10px;
                padding: 9px 12px;
                border-radius: var(--radius);
                color: rgba(255,255,255,0.65);
                text-decoration: none;
                font-size: 13px; font-weight: 500;
                transition: background var(--transition), color var(--transition);
                margin-bottom: 2px;
                position: relative;
            }
            .g-nav-link i { font-size: 17px; flex-shrink: 0; }
            .g-nav-link:hover {
                background: rgba(4,120,87,0.5);
                color: var(--g-cream);
            }
            .g-nav-link.active {
                background: var(--g-teal);
                color: var(--g-cream);
            }
            .g-nav-link .badge-alert {
                margin-left: auto;
                background: var(--g-danger);
                color: #fff;
                font-size: 10px; font-weight: 600;
                padding: 1px 6px;
                border-radius: 20px;
                min-width: 18px; text-align: center;
            }

            /* Sidebar footer */
            .g-sidebar-footer {
                padding: 1rem;
                border-top: 1px solid rgba(255,255,255,0.12);
            }
            .g-sidebar-user {
                display: flex; align-items: center; gap: 10px;
            }
            .g-sidebar-avatar {
                width: 36px; height: 36px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--g-teal);
                flex-shrink: 0;
            }
            .g-sidebar-avatar-placeholder {
                width: 36px; height: 36px;
                border-radius: 50%;
                background: var(--g-teal);
                border: 2px solid rgba(255,255,255,0.35);
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
                font-size: 14px; font-weight: 600;
                color: var(--g-cream);
            }
            .g-sidebar-user-info { flex: 1; min-width: 0; }
            .g-sidebar-user-name {
                font-size: 12px; font-weight: 600;
                color: var(--g-cream);
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .g-sidebar-user-role {
                font-size: 10px; color: var(--g-sage);
                text-transform: capitalize;
            }

            /* =============================================
               TOPBAR
            ============================================= */
            .g-topbar {
                position: fixed;
                top: 0;
                left: var(--sidebar-w);
                right: 0;
                height: var(--topbar-h);
                background: var(--g-white);
                border-bottom: 1px solid var(--g-border);
                display: flex; align-items: center;
                padding: 0 1.5rem;
                gap: 12px;
                z-index: 999;
            }

            /* Mobile toggle */
            .g-topbar-toggle {
                display: none;
                background: none; border: none;
                color: var(--g-teal); font-size: 22px;
                cursor: pointer; padding: 4px;
            }

            .g-topbar-title {
                font-size: 16px; font-weight: 600;
                color: var(--g-navy);
                flex: 1;
            }
            .g-topbar-title small {
                font-size: 12px; font-weight: 400;
                color: var(--g-muted);
                margin-left: 8px;
            }

            /* Sede badge */
            .g-sede-badge {
                display: flex; align-items: center; gap: 5px;
                background: rgba(4,120,87,0.08);
                color: var(--g-teal);
                font-size: 12px; font-weight: 500;
                padding: 5px 12px;
                border-radius: 20px;
                border: 1px solid rgba(4,120,87,0.2);
            }
            .g-sede-badge i { font-size: 13px; }

            /* Notificaciones */
            .g-topbar-btn {
                position: relative;
                width: 38px; height: 38px;
                border-radius: 10px;
                border: 1px solid var(--g-border);
                background: var(--g-white);
                display: flex; align-items: center; justify-content: center;
                color: var(--g-teal); font-size: 18px;
                cursor: pointer; text-decoration: none;
                transition: background var(--transition);
            }
            .g-topbar-btn:hover { background: var(--g-bg); color: var(--g-teal); }
            .g-topbar-btn .dot {
                position: absolute; top: 7px; right: 7px;
                width: 7px; height: 7px;
                background: var(--g-danger);
                border-radius: 50%;
                border: 1.5px solid var(--g-white);
            }

            /* Avatar topbar + dropdown */
            .g-profile-wrap { position: relative; }
            .g-profile-btn {
                display: flex; align-items: center; gap: 8px;
                padding: 4px 10px 4px 4px;
                border-radius: 24px;
                border: 1px solid var(--g-border);
                background: var(--g-white);
                cursor: pointer;
                transition: background var(--transition);
            }
            .g-profile-btn:hover { background: var(--g-bg); }
            .g-profile-avatar {
                width: 32px; height: 32px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--g-teal);
            }
            .g-profile-avatar-placeholder {
                width: 32px; height: 32px;
                border-radius: 50%;
                background: var(--g-teal);
                display: flex; align-items: center; justify-content: center;
                font-size: 12px; font-weight: 600;
                color: var(--g-cream);
                border: 2px solid rgba(4,120,87,0.3);
            }
            .g-profile-name {
                font-size: 13px; font-weight: 500;
                color: var(--g-navy);
                max-width: 130px;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .g-profile-btn i.bi-chevron-down {
                font-size: 11px; color: var(--g-muted);
            }

            /* Dropdown */
            .g-dropdown {
                position: absolute; top: calc(100% + 8px); right: 0;
                width: 210px;
                background: var(--g-white);
                border: 1px solid var(--g-border);
                border-radius: var(--radius);
                box-shadow: 0 8px 24px rgba(15,23,42,0.1);
                display: none;
                z-index: 2000;
                overflow: hidden;
            }
            .g-dropdown.show { display: block; }
            .g-dropdown-header {
                padding: 12px 14px;
                border-bottom: 1px solid var(--g-border);
            }
            .g-dropdown-header .d-name {
                font-size: 13px; font-weight: 600; color: var(--g-navy);
            }
            .g-dropdown-header .d-role {
                font-size: 11px; color: var(--g-muted);
                text-transform: capitalize;
            }
            .g-dropdown-item {
                display: flex; align-items: center; gap: 10px;
                padding: 9px 14px;
                font-size: 13px; color: var(--g-text);
                text-decoration: none;
                transition: background var(--transition);
            }
            .g-dropdown-item:hover { background: var(--g-bg); }
            .g-dropdown-item i { font-size: 15px; color: var(--g-teal); }
            .g-dropdown-item.danger { color: var(--g-danger); }
            .g-dropdown-item.danger i { color: var(--g-danger); }
            .g-dropdown-divider {
                height: 1px; background: var(--g-border); margin: 2px 0;
            }

            /* =============================================
               MAIN CONTENT
            ============================================= */
            .g-main {
                margin-left: var(--sidebar-w);
                margin-top: var(--topbar-h);
                padding: 1.5rem;
                min-height: calc(100vh - var(--topbar-h));
            }

            /* =============================================
               OVERLAY (mobile)
            ============================================= */
            .g-overlay {
                display: none;
                position: fixed; inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 999;
            }

            /* =============================================
               RESPONSIVE
            ============================================= */
            @@media (max-width: 768px) {
                .g-sidebar {
                    transform: translateX(-100%);
                }
                .g-sidebar.open {
                    transform: translateX(0);
                }
                .g-overlay.open { display: block; }
                .g-topbar {
                    left: 0;
                }
                .g-main {
                    margin-left: 0;
                }
                .g-topbar-toggle { display: flex; }
                .g-profile-name { display: none; }
                .g-sede-badge span { display: none; }
            }

            /* =============================================
               UTILIDADES GLOBALES
            ============================================= */
            .card-g {
                background: var(--g-white);
                border: 1px solid var(--g-border);
                border-radius: 12px;
                padding: 1.25rem;
            }
            .btn-g-primary {
                background: var(--g-teal);
                color: var(--g-cream);
                border: none;
                border-radius: var(--radius);
                padding: 9px 18px;
                font-size: 13px; font-weight: 500;
                cursor: pointer;
                transition: background var(--transition);
                font-family: inherit;
            }
            .btn-g-primary:hover { background: #065F46; color: var(--g-cream); }
            .btn-g-outline {
                background: transparent;
                color: var(--g-teal);
                border: 1px solid var(--g-teal);
                border-radius: var(--radius);
                padding: 8px 18px;
                font-size: 13px; font-weight: 500;
                cursor: pointer;
                transition: all var(--transition);
                font-family: inherit;
            }
            .btn-g-outline:hover {
                background: var(--g-teal);
                color: var(--g-cream);
            }
            .badge-entrada {
                background: rgba(4,120,87,0.12);
                color: var(--g-teal);
                font-size: 11px; font-weight: 600;
                padding: 3px 9px; border-radius: 20px;
            }
            .badge-salida {
                background: rgba(220,38,38,0.1);
                color: var(--g-danger);
                font-size: 11px; font-weight: 600;
                padding: 3px 9px; border-radius: 20px;
            }
            .badge-alerta {
                background: rgba(220,38,38,0.1);
                color: var(--g-danger);
                font-size: 11px; font-weight: 600;
                padding: 3px 9px; border-radius: 20px;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        var nombreCompleto = User.FindFirst("NombreCompleto")?.Value ?? "";
        var rol = RolHelper.Etiqueta(User.FindFirst(ClaimTypes.Role)?.Value);
        var sedeNombre = User.FindFirst("SedeNombre")?.Value ?? "";
        var fotoUrl = User.FindFirst("FotoUrl")?.Value ?? "";
        var initials = string.Concat(nombreCompleto.Split(' ')
                                .Where(w => w.Length > 0)
                                .Take(2)
                                .Select(w => w[0].ToString().ToUpper()));
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- OVERLAY móvil -->
    <div class="g-overlay" id="gOverlay"></div>

    <!-- ================================================
     SIDEBAR
================================================ -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="g-sidebar" id="gSidebar">

            <!-- Brand -->
            <a class="g-brand" asp-controller="Home" asp-action="Index">
                <div class="g-brand-icon">
                    <i class="bi bi-boxes"></i>
                </div>
                <div class="g-brand-text">
                    <span class="g-brand-name">Golocentro</span>
                    <span class="g-brand-sub">ALMACÉN</span>
                </div>
            </a>

            <!-- Nav -->
            <nav class="g-nav">

                <div class="g-nav-section">Principal</div>

                <a class="g-nav-link @(currentController == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="g-nav-section">Movimientos</div>

                <a class="g-nav-link @(currentController == "Movimiento" && currentAction == "Entrada" ? "active" : "")"
                   asp-controller="Movimiento" asp-action="Entrada">
                    <i class="bi bi-box-arrow-in-down"></i> Entradas
                </a>

                <a class="g-nav-link @(currentController == "Movimiento" && currentAction == "Salida" ? "active" : "")"
                   asp-controller="Movimiento" asp-action="Salida">
                    <i class="bi bi-box-arrow-up"></i> Salidas
                </a>

                <div class="g-nav-section">Inventario</div>

                <a class="g-nav-link @(currentController == "Producto" && currentAction == "Stock" ? "active" : "")"
                   asp-controller="Producto" asp-action="Stock">
                    <i class="bi bi-bar-chart-line"></i> Stock
                </a>

                <a class="g-nav-link @(currentController == "Mapa" ? "active" : "")"
                   asp-controller="Mapa" asp-action="Index">
                    <i class="bi bi-map"></i> Mapa Almacén
                </a>

                <a class="g-nav-link @(currentController == "Alerta" ? "active" : "")"
                   asp-controller="Alerta" asp-action="Index">
                    <i class="bi bi-bell"></i> Alertas
                    @* Puedes reemplazar "3" con un valor dinámico desde ViewBag *@
                    <span class="badge-alert" id="alertaBadge" style="display:none"></span>
                </a>

                @if (User.IsInRole("duena") || User.IsInRole("encargada"))
                {
                    <div class="g-nav-section">Gestión</div>

                    <a class="g-nav-link @(currentController == "Producto" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Producto" asp-action="Index">
                        <i class="bi bi-tags"></i> Productos
                    </a>

                    <a class="g-nav-link @(currentController == "Cliente" ? "active" : "")"
                       asp-controller="Cliente" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>

                    <a class="g-nav-link @(currentController == "Proveedor" ? "active" : "")"
                       asp-controller="Proveedor" asp-action="Index">
                        <i class="bi bi-truck"></i> Proveedores
                    </a>

                    <a class="g-nav-link @(currentController == "Reporte" ? "active" : "")"
                       asp-controller="Reporte" asp-action="Index">
                        <i class="bi bi-file-earmark-bar-graph"></i> Reportes
                    </a>
                }

            </nav>

            <!-- Usuario en sidebar (mini) -->
            <div class="g-sidebar-footer">
                <div class="g-sidebar-user">
                    @if (!string.IsNullOrEmpty(fotoUrl))
                    {
                        <img src="@Url.Content("~/uploads/perfiles/" + fotoUrl)"
                             alt="Foto perfil" class="g-sidebar-avatar" />
                    }
                    else
                    {
                        <div class="g-sidebar-avatar-placeholder">@initials</div>
                    }
                    <div class="g-sidebar-user-info">
                        <span class="g-sidebar-user-name">@nombreCompleto</span>
                        <span class="g-sidebar-user-role">@rol</span>
                    </div>
                </div>
            </div>

        </aside>
    }

    <!-- ================================================
     TOPBAR
================================================ -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="g-topbar">

            <!-- Toggle móvil -->
            <button class="g-topbar-toggle" id="gToggle" aria-label="Menú">
                <i class="bi bi-list"></i>
            </button>

            <!-- Título de página actual -->
            <div class="g-topbar-title">
                @(ViewData["Title"] ?? "Dashboard")
                <small>Golocentro</small>
            </div>

            <!-- Sede -->
            <div class="g-sede-badge">
                <i class="bi bi-geo-alt-fill"></i>
                <span>@sedeNombre</span>
            </div>

            <!-- Alertas -->
            <a class="g-topbar-btn" asp-controller="Alerta" asp-action="Index"
               title="Ver alertas" id="alertaTopBtn">
                <i class="bi bi-bell"></i>
            </a>

            <!-- Perfil -->
            <div class="g-profile-wrap">
                <button class="g-profile-btn" id="gProfileBtn" type="button">
                    @if (!string.IsNullOrEmpty(fotoUrl))
                    {
                        <img src="@Url.Content("~/uploads/perfiles/" + fotoUrl)"
                             alt="Foto" class="g-profile-avatar" />
                    }
                    else
                    {
                        <div class="g-profile-avatar-placeholder">@initials</div>
                    }
                    <span class="g-profile-name">@nombreCompleto</span>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <div class="g-dropdown" id="gDropdown">
                    <div class="g-dropdown-header">
                        <div class="d-name">@nombreCompleto</div>
                        <div class="d-role">@rol · @sedeNombre</div>
                    </div>
                    <a class="g-dropdown-item" asp-controller="Account" asp-action="Perfil">
                        <i class="bi bi-person-circle"></i> Mi Perfil
                    </a>
                    <a class="g-dropdown-item" asp-controller="Account" asp-action="CambiarFoto">
                        <i class="bi bi-camera"></i> Cambiar Foto
                    </a>
                    <div class="g-dropdown-divider"></div>
                    <a class="g-dropdown-item danger" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                    </a>
                </div>
            </div>

        </header>
    }

    <!-- ================================================
     CONTENIDO PRINCIPAL
================================================ -->
    <div class="g-main @(User.Identity?.IsAuthenticated != true ? "p-0" : "")">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle sidebar móvil
        const toggle   = document.getElementById('gToggle');
        const sidebar  = document.getElementById('gSidebar');
        const overlay  = document.getElementById('gOverlay');

        if (toggle) {
        toggle.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        overlay.classList.toggle('open');
        });
        overlay.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
        });
        }

        // Dropdown perfil
        const profileBtn = document.getElementById('gProfileBtn');
        const dropdown   = document.getElementById('gDropdown');

        if (profileBtn) {
        profileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('show');
        });
        document.addEventListener('click', () => dropdown.classList.remove('show'));
        }

        // Cargar conteo de alertas activas vía fetch
        fetch('/Alerta/ConteoActivas')
        .then(r => r.ok ? r.json() : null)
        .then(data => {
        if (data && data.total > 0) {
        const badge    = document.getElementById('alertaBadge');
        const topBtn   = document.getElementById('alertaTopBtn');
        if (badge)  { badge.textContent = data.total; badge.style.display = 'inline-block'; }
        if (topBtn) {
        const dot = document.createElement('span');
        dot.className = 'dot';
        topBtn.appendChild(dot);
        }
        }
        })
        .catch(() => {});
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
