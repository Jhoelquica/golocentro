@* Carrito de productos con panel lateral (Nueva venta y Nueva entrada) *@
<style>
    .vn-page {
        max-width: 1180px;
    }

    .vn-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 20px;
        align-items: start;
    }

    .vn-col {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .vn-cobro {
        position: sticky;
        top: calc(var(--topbar-h) + 16px);
    }

    @@media (max-width: 991.98px) {
        .vn-grid {
            grid-template-columns: 1fr;
        }

        .vn-cobro {
            position: static;
        }
    }

    .vn-card {
        background: var(--g-white);
        border: 1px solid var(--g-border);
        border-radius: 14px;
        padding: 1.25rem;
    }

    .vn-titulo {
        font-size: 16px;
        font-weight: 600;
        color: var(--g-navy);
        margin: 0 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .vn-titulo > i {
            color: var(--g-teal);
        }

    /* Buscadores */
    .vn-buscar {
        position: relative;
    }

        .vn-buscar > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--g-muted);
            pointer-events: none;
        }

        .vn-buscar input {
            width: 100%;
            height: 48px;
            padding: 0 12px 0 40px;
            border: 1px solid var(--g-input-border);
            border-radius: 10px;
            font-size: 16px;
            font-family: inherit;
            color: var(--g-text);
            background: var(--g-white);
        }

            .vn-buscar input::placeholder {
                color: #64748B;
            }

    .vn-card input:focus,
    .vn-card select:focus,
    .vn-card textarea:focus {
        outline: none;
        border-color: var(--g-teal);
        box-shadow: 0 0 0 3px rgba(4,120,87,0.25);
    }

    .vn-resultados {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px;
    }

    .vn-opcion {
        width: 100%;
        min-height: 56px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 10px;
        row-gap: 2px;
        align-items: center;
        text-align: left;
        padding: 9px 12px;
        border: 1px solid var(--g-border);
        border-radius: 10px;
        background: var(--g-white);
        font-family: inherit;
        cursor: pointer;
        transition: border-color var(--transition), background var(--transition);
    }

        .vn-opcion:hover {
            border-color: var(--g-teal);
            background: rgba(4,120,87,0.04);
        }

        .vn-opcion:focus-visible {
            outline: 2px solid var(--g-teal);
            outline-offset: 1px;
        }

    .vn-opcion-nombre {
        font-size: 14px;
        font-weight: 600;
        color: var(--g-text);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .vn-opcion-meta {
        grid-row: 2;
        font-size: 12px;
        color: var(--g-muted);
    }

    .vn-opcion-precio {
        font-size: 14px;
        font-weight: 600;
        color: var(--g-teal);
        font-variant-numeric: tabular-nums;
    }

    .vn-opcion > i {
        grid-column: 2;
        grid-row: 2;
        justify-self: end;
        color: var(--g-teal);
    }

    .vn-mas {
        font-size: 13px;
        color: var(--g-muted);
        margin: 8px 0 0;
    }

        .vn-mas:empty {
            display: none;
        }

    /* Carrito */
    .vn-subtitulo {
        font-size: 14px;
        font-weight: 600;
        color: var(--g-text);
        margin: 20px 0 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .vn-contador {
        min-width: 24px;
        padding: 0 8px;
        border-radius: 999px;
        background: var(--g-bg);
        border: 1px solid var(--g-border);
        font-size: 12px;
        text-align: center;
    }

    .vn-carrito {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .vn-carrito-vacio {
        border: 1px dashed var(--g-input-border);
        border-radius: 10px;
        padding: 1.25rem;
        text-align: center;
        color: var(--g-muted);
        font-size: 14px;
    }

        .vn-carrito-vacio i {
            display: block;
            font-size: 24px;
            margin-bottom: 4px;
        }

    .vn-linea {
        border: 1px solid var(--g-border);
        border-radius: 10px;
        padding: 12px;
        background: var(--g-bg);
    }

        .vn-linea.vn-destacar {
            animation: vn-destello 0.9s ease;
        }

    @@keyframes vn-destello {
        from {
            box-shadow: 0 0 0 3px rgba(4,120,87,0.4);
        }

        to {
            box-shadow: 0 0 0 0 rgba(4,120,87,0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .vn-linea.vn-destacar {
            animation: none;
        }
    }

    .vn-linea-cab {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 8px;
    }

    .vn-linea-nombre {
        font-size: 15px;
        font-weight: 600;
        color: var(--g-text);
    }

    /* "Vende por": unidad base o una presentación (bolsa, caja, pack) del producto */
    .vn-f-presentacion {
        max-width: 360px;
        margin-bottom: 10px;
    }

    .vn-linea-campos {
        display: grid;
        grid-template-columns: minmax(120px, 1.1fr) 148px minmax(110px, 1fr) minmax(84px, auto);
        gap: 10px;
        align-items: end;
    }

    @@media (max-width: 640px) {
        .vn-linea-campos {
            grid-template-columns: 1fr 1fr;
        }
    }

    .vn-f label,
    .vn-f-etiqueta {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: var(--g-muted);
        margin-bottom: 4px;
    }

    .vn-f select,
    .vn-f input {
        width: 100%;
        height: 44px;
        padding: 0 10px;
        border: 1px solid var(--g-input-border);
        border-radius: 8px;
        font-size: 15px;
        font-family: inherit;
        color: var(--g-text);
        background: var(--g-white);
        font-variant-numeric: tabular-nums;
    }

        .vn-f input[aria-invalid="true"],
        .vn-descuento input[aria-invalid="true"] {
            border-color: var(--g-danger);
            box-shadow: 0 0 0 1px var(--g-danger);
        }

    .vn-stepper {
        display: flex;
    }

        .vn-stepper button {
            flex: none;
            width: 44px;
            height: 44px;
            border: 1px solid var(--g-input-border);
            background: var(--g-white);
            color: var(--g-navy);
            font-size: 16px;
            cursor: pointer;
        }

            .vn-stepper button:first-child {
                border-radius: 8px 0 0 8px;
                border-right: none;
            }

            .vn-stepper button:last-child {
                border-radius: 0 8px 8px 0;
                border-left: none;
            }

            .vn-stepper button:hover {
                color: var(--g-teal);
                background: rgba(4,120,87,0.06);
            }

            .vn-stepper button:focus-visible {
                outline: 2px solid var(--g-teal);
                outline-offset: -2px;
            }

        .vn-f .vn-stepper input {
            border-radius: 0;
            text-align: center;
            padding: 0 4px;
        }

    /* Sin flechitas del navegador: tapan el monto y la cantidad ya tiene sus botones */
    .vn-card input[type="number"] {
        -moz-appearance: textfield;
    }

        .vn-card input[type="number"]::-webkit-outer-spin-button,
        .vn-card input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .vn-moneda {
        position: relative;
    }

        .vn-moneda > span {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            font-weight: 600;
            color: var(--g-muted);
            pointer-events: none;
        }

        .vn-f .vn-moneda input,
        .vn-descuento .vn-moneda input {
            padding-left: 32px;
        }

    .vn-f-importe {
        text-align: right;
    }

    .vn-importe {
        display: block;
        height: 44px;
        line-height: 44px;
        font-size: 16px;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--g-navy);
    }

    .vn-linea-aviso {
        margin: 8px 0 0;
        font-size: 13px;
        color: var(--g-muted);
    }

        .vn-linea-aviso:empty {
            display: none;
        }

        .vn-linea-aviso.error {
            color: var(--g-danger-text);
            font-weight: 500;
        }

    /* Cobro */
    .vn-bloque {
        border: none;
        padding: 0;
        margin: 0 0 18px;
        min-width: 0;
    }

        .vn-bloque legend {
            float: none;
            width: auto;
            padding: 0;
            font-size: 14px;
            font-weight: 600;
            color: var(--g-text);
            margin-bottom: 8px;
        }

    /* El radio sigue siendo enfocable con teclado; la etiqueta es lo que se ve */
    .vn-radio {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
        pointer-events: none;
    }

    .vn-segmento {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        padding: 4px;
        background: var(--g-bg);
        border: 1px solid var(--g-border);
        border-radius: 10px;
    }

        .vn-segmento label {
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 6px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--g-muted);
            text-align: center;
            cursor: pointer;
        }

        .vn-segmento .vn-radio:checked + label {
            background: var(--g-white);
            color: var(--g-teal);
            box-shadow: 0 1px 3px rgba(15,23,42,0.14);
        }

    .vn-radio:focus-visible + label {
        outline: 2px solid var(--g-teal);
        outline-offset: 2px;
    }

    .vn-cliente {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
        padding: 10px 12px;
        border: 1px solid var(--g-teal);
        border-radius: 10px;
        background: rgba(4,120,87,0.05);
    }

        .vn-cliente .cp-nombre {
            font-size: 14px;
        }

    .vn-btn-sm {
        min-height: 36px;
        padding: 6px 12px;
    }

    .vn-buscador-cliente {
        margin-top: 10px;
    }

        .vn-buscador-cliente .vn-resultados {
            grid-template-columns: 1fr;
            margin-bottom: 8px;
        }

            .vn-buscador-cliente .vn-resultados:empty {
                display: none;
            }

    .vn-metodos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

        .vn-metodos label {
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid var(--g-input-border);
            border-radius: 10px;
            background: var(--g-white);
            font-size: 14px;
            font-weight: 600;
            color: var(--g-text);
            cursor: pointer;
        }

            .vn-metodos label:last-of-type {
                grid-column: span 2;
            }

            .vn-metodos label i {
                font-size: 18px;
                color: var(--g-muted);
            }

        .vn-metodos .vn-radio:checked + label {
            border-color: var(--g-teal);
            background: rgba(4,120,87,0.08);
            color: var(--g-teal);
            box-shadow: inset 0 0 0 1px var(--g-teal);
        }

            .vn-metodos .vn-radio:checked + label i {
                color: var(--g-teal);
            }

    .vn-totales {
        border-top: 1px dashed var(--g-input-border);
        padding-top: 12px;
        margin-bottom: 14px;
    }

    .vn-total-fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 4px 0;
        font-size: 14px;
        color: var(--g-text);
        font-variant-numeric: tabular-nums;
    }

    .vn-descuento label {
        font-weight: 400;
        margin: 0;
    }

    .vn-descuento .vn-moneda {
        width: 132px;
    }

    .vn-descuento input {
        width: 100%;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--g-input-border);
        border-radius: 8px;
        font-size: 15px;
        font-family: inherit;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .vn-error {
        font-size: 13px;
        color: var(--g-danger-text);
        text-align: right;
    }

        .vn-error:empty {
            display: none;
        }

    .vn-total {
        margin-top: 6px;
        padding-top: 10px;
        border-top: 1px solid var(--g-border);
        font-size: 22px;
        font-weight: 700;
        color: var(--g-navy);
    }

    .vn-motivo {
        font-size: 13px;
        font-weight: 500;
        color: var(--g-danger-text);
        margin: 0 0 10px;
    }

        .vn-motivo:empty {
            display: none;
        }

    .vn-registrar {
        width: 100%;
        min-height: 52px;
        font-size: 16px;
    }

    .vn-card .cp-campo input[type="file"] {
        padding: 9px 10px;
        font-size: 14px;
    }

    .vn-sin-stock {
        max-width: 640px;
    }
</style>
