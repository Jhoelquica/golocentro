@model GestionAlmacen_Golocentro.Models.Producto
@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> ¿Eliminar producto?</h2>
    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Código:</strong> @Model.Codigo</p>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdProducto" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>