@model IEnumerable<GestionAlmacen_Golocentro.ViewModels.StockViewModels>
@{
    ViewData["Title"] = "Consulta de Stock";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-boxes"></i> Stock Actual</h2>

    <!-- Filtro de búsqueda -->
    <form method="get" asp-action="Stock" class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="filtroNombre" class="form-control"
                       placeholder="Buscar por nombre de producto..." value="@ViewBag.FiltroNombre">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Ubicación (Estante)</th>
                    <th>Sede</th>
                    <th class="text-end">Stock</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string claseFila = "";
                    if (item.BajoStock)
                        claseFila = "table-danger";
                    else if (item.StockActual == 0)
                        claseFila = "table-warning";

                    <tr class="@claseFila">
                        <td>@item.ProductoNombre</td>
                        <td>@item.CodigoUbicacion</td>
                        <td>@item.SedeNombre</td>
                        <td class="text-end fw-bold">@item.StockActual</td>
                        <td>
                            @if (item.BajoStock)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Bajo</span>
                            }
                            else if (item.StockActual == 0)
                            {
                                <span class="badge bg-warning text-dark">Sin stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Normal</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info">No se encontraron productos en stock para su sede.</div>
    }
</div>

@section Scripts {
    <script>
        // Aquí podrías agregar filtros adicionales
    </script>
}