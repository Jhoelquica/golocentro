@using System.Globalization
@using GestionAlmacen_Golocentro.ViewModels
@model ProductoListaViewModel
@{
    ViewData["Title"] = "Productos";
    var hayFiltro = !string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.Tipo);
    var hoy = DateOnly.FromDateTime(DateTime.Today);
}

@functions {
    static string Soles(decimal v) => "S/ " + v.ToString("0.00", CultureInfo.InvariantCulture);
}

@await Html.PartialAsync("~/Views/Shared/_EstilosGestion.cshtml")

<style>
    .pr-select {
        height: 44px;
        border: 1px solid var(--g-input-border);
        border-radius: 8px;
        padding: 0 10px;
        font-size: 15px;
        font-family: inherit;
        color: var(--g-text);
        background: var(--g-white);
        max-width: 220px;
    }

        .pr-select:focus {
            outline: none;
            border-color: var(--g-teal);
            box-shadow: 0 0 0 3px rgba(4,120,87,0.25);
        }

    .pr-num {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .pr-chip {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 1px 8px;
        border-radius: 20px;
        white-space: nowrap;
        margin-top: 2px;
    }

        .pr-chip.bajo,
        .pr-chip.pronto {
            color: #92400E;
            background: rgba(245,158,11,0.15);
        }

        .pr-chip.vencido {
            color: var(--g-danger-text);
            background: rgba(220,38,38,0.1);
        }

    .pr-donde {
        font-size: 12px;
        font-weight: 600;
        color: var(--g-teal);
        white-space: nowrap;
    }

    @@container (max-width: 760px) {
        .pr-col-tipo {
            display: none;
        }
    }

    @@container (max-width: 600px) {
        .pr-col-vence {
            display: none;
        }
    }
</style>

<div class="cp-page">

    <div class="cp-header">
        <div>
            <h1><i class="bi bi-tags" aria-hidden="true"></i> Productos</h1>
            <p>
                @if (hayFiltro)
                {
                    <span>@Model.Total @(Model.Total == 1 ? "resultado" : "resultados")</span>
                }
                else
                {
                    <span>@Model.Total @(Model.Total == 1 ? "producto en el catálogo" : "productos en el catálogo")</span>
                }
            </p>
        </div>
        @if (Model.PuedeEditar)
        {
            <a class="btn-g-primary" asp-action="Crear">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo producto
            </a>
        }
    </div>

    @if (TempData["Exito"] is string exito)
    {
        <div class="cp-aviso exito" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@exito</span>
            <button type="button" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="cp-aviso error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@error</span>
            <button type="button" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }

    <form class="cp-busqueda" method="get" role="search" asp-action="Index">
        <label for="q" class="visually-hidden">Buscar productos por nombre, código o tipo</label>
        <div class="cp-busqueda-campo">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="q" name="q" type="search" value="@Model.Busqueda" placeholder="Buscar por nombre, código o tipo" autocomplete="off" />
        </div>
        <label for="tipo" class="visually-hidden">Categoría</label>
        <select id="tipo" name="tipo" class="pr-select">
            <option value="">Todas las categorías</option>
            @foreach (var t in Model.Tipos)
            {
                <option value="@t" selected="@(t == Model.Tipo)">@t</option>
            }
        </select>
        <button type="submit" class="btn-g-outline">Buscar</button>
        @if (hayFiltro)
        {
            <a class="cp-limpiar" asp-action="Index">Limpiar filtros</a>
        }
    </form>

    <section class="cp-panel" aria-label="Catálogo de productos">
        @if (Model.Filas.Count == 0)
        {
            <div class="cp-vacio">
                @if (hayFiltro)
                {
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <p>No encontramos productos con esos filtros.</p>
                    <p>Revisa cómo está escrito o busca por código. <a asp-action="Index">Ver todos</a></p>
                }
                else
                {
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <p>Aún no hay productos en el catálogo.</p>
                    @if (Model.PuedeEditar)
                    {
                        <a asp-action="Crear">Registrar el primero</a>
                    }
                }
            </div>
        }
        else
        {
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <caption class="visually-hidden">Productos, página @Model.Pagina de @Model.TotalPaginas</caption>
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="pr-col-tipo">Tipo</th>
                            <th scope="col">Precio</th>
                            <th scope="col">Stock</th>
                            <th scope="col" class="pr-col-vence">Vence</th>
                            @if (Model.PuedeEditar)
                            {
                                <th scope="col"><span class="visually-hidden">Acciones</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Filas)
                        {
                            var bajo = p.Stock <= p.StockMinimo;
                            <tr>
                                <td>
                                    <div class="cp-nombre">@p.Nombre</div>
                                    <div class="cp-sub">@p.Codigo</div>
                                </td>
                                <td class="pr-col-tipo">@p.Tipo</td>
                                <td class="pr-num">
                                    @Soles(p.Precio)
                                    <div class="cp-sub">por @p.UnidadMedida</div>
                                    @if (Model.Presentaciones.TryGetValue(p.Id, out var presentaciones))
                                    {
                                        foreach (var pr in presentaciones)
                                        {
                                            <div class="cp-sub">@Soles(pr.Precio) por @pr.Nombre de @pr.Factor</div>
                                        }
                                    }
                                </td>
                                <td>
                                    <div class="pr-num">@p.Stock</div>
                                    @if (bajo)
                                    {
                                        <span class="pr-chip bajo" title="Mínimo: @p.StockMinimo">@(p.Stock == 0 ? "Sin stock" : "Stock bajo")</span>
                                    }
                                    @if (p.Stock > 0)
                                    {
                                        <div><a class="pr-donde" asp-controller="Mapa" asp-action="Index" asp-route-buscar="@p.Codigo" aria-label="Ver dónde está @p.Nombre en el mapa">¿Dónde está?</a></div>
                                    }
                                </td>
                                <td class="pr-col-vence">
                                    @if (p.FechaVencimiento is DateOnly vence)
                                    {
                                        <div class="pr-num">@vence.ToString("dd/MM/yyyy")</div>
                                        @if (vence < hoy)
                                        {
                                            <span class="pr-chip vencido">Vencido</span>
                                        }
                                        else if (vence <= hoy.AddDays(30))
                                        {
                                            <span class="pr-chip pronto">Vence pronto</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="cp-sub">—</span>
                                    }
                                </td>
                                @if (Model.PuedeEditar)
                                {
                                    <td>
                                        <div class="cp-acciones">
                                            <a class="cp-icono-btn" asp-action="Editar" asp-route-id="@p.Id" aria-label="Editar @p.Nombre" title="Editar">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>
                                            @if (!p.TieneHistorial)
                                            {
                                                <button type="button" class="cp-icono-btn peligro" data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                        data-nombre="@p.Nombre" data-url="@Url.Action("Eliminar", new { id = p.Id })"
                                                        aria-label="Eliminar @p.Nombre" title="Eliminar">
                                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <nav class="cp-paginacion" aria-label="Paginación">
                    @if (Model.Pagina > 1)
                    {
                        <a class="btn-g-outline" asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-tipo="@Model.Tipo" asp-route-pagina="@(Model.Pagina - 1)">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
                        </a>
                    }
                    else
                    {
                        <span class="cp-pag-espacio"></span>
                    }
                    <span>Página @Model.Pagina de @Model.TotalPaginas</span>
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a class="btn-g-outline" asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-tipo="@Model.Tipo" asp-route-pagina="@(Model.Pagina + 1)">
                            Siguiente <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="cp-pag-espacio"></span>
                    }
                </nav>
            }
        }
    </section>
</div>

@if (Model.PuedeEditar)
{
    <div class="modal fade cp-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="cp-modal-icono" aria-hidden="true"><i class="bi bi-trash3"></i></div>
                        <h2 id="modalEliminarTitulo">¿Eliminar este producto?</h2>
                        <p>Se eliminará <strong id="nombreEliminar"></strong> del catálogo. Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-g-outline" data-bs-dismiss="modal" id="btnCancelarEliminar">Cancelar</button>
                        <button type="submit" class="btn-g-danger">Sí, eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.PuedeEditar)
    {
        <script>
            const modalEliminar = document.getElementById('modalEliminar');
            modalEliminar.addEventListener('show.bs.modal', function (e) {
                document.getElementById('formEliminar').action = e.relatedTarget.dataset.url;
                document.getElementById('nombreEliminar').textContent = e.relatedTarget.dataset.nombre;
            });
            // En una acción destructiva el foco inicial va a "Cancelar"
            modalEliminar.addEventListener('shown.bs.modal', function () {
                document.getElementById('btnCancelarEliminar').focus();
            });
        </script>
    }
}
