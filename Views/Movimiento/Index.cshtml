@model IEnumerable<GestionAlmacen_Golocentro.Models.Movimiento>
@{
    ViewData["Title"] = "Movimientos";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-list-ul"></i> Lista de Movimientos</h2>

    <p>
        <a asp-action="Entrada" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Entrada
        </a>
        <a asp-action="Salida" class="btn btn-warning">
            <i class="bi bi-dash-circle"></i> Nueva Salida
        </a>
    </p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Sede</th>
                <th>Proveedor</th>
                <th>Comprobante</th>
                <th>Evidencia</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdMovimiento</td>
                    <td>@item.Tipo</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.IdUsuarioNavigation?.Nombre</td>
                    <td>@item.IdSedeNavigation?.Nombre</td>
                    <td>@item.IdProveedorNavigation?.Nombre</td>
                    <td>
                        @if (item.ComprobanteEmitido)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        @if (item.Evidencia != null && item.Evidencia.Any())
                        {
                            foreach (var ev in item.Evidencia)
                            {
                                <a href="@ev.UrlArchivo" target="_blank" class="btn btn-sm btn-outline-info" title="Ver evidencia">
                                    <i class="bi bi-image"></i> Ver
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@item.IdMovimiento" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-info-circle"></i> Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>