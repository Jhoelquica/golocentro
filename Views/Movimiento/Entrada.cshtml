@model GestionAlmacen_Golocentro.ViewModels.MovimientoEntradaViewModel
@{
    ViewData["Title"] = "Registrar Entrada";
    // ProveedorController solo admite a estos roles
    var puedeCrearProveedor = User.IsInRole("duena") || User.IsInRole("encargada");
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-box-arrow-in-down"></i> Registrar Entrada de Productos</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert" tabindex="-1" id="resumenErrores">
            <strong><i class="bi bi-exclamation-triangle-fill"></i> Revisa lo siguiente antes de continuar:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Entrada" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <!-- nuevo producto -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span></span>
            <a href="/Producto/Create" target="_blank" class="btn btn-sm btn-outline-success">
                <i class="bi bi-plus-circle"></i> Nuevo producto (nueva pestaña)
            </a>
        </div>
        <!-- Tabla dinámica de productos -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-cart-plus"></i> Productos
            </div>
            <div class="card-body">
                <table class="table table-bordered" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Producto <span class="text-danger">*</span></th>
                            <th>Ubicación <span class="text-danger">*</span></th>
                            <th>Cantidad <span class="text-danger">*</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Las filas se agregan dinámicamente -->
                    </tbody>
                </table>

                <div id="estadoVacio" class="text-center border rounded py-4 text-muted" style="display:none; border-style: dashed;">
                    <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                    Sin productos agregados todavía.
                </div>

                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAgregarFila">
                    <i class="bi bi-plus-circle"></i> Agregar producto
                </button>
            </div>
        </div>

        <!-- Datos generales -->
        <div class="row">
            <div class="col-md-6 col-xl-4 mb-3">
                <label asp-for="ProveedorId" class="form-label fw-bold">Proveedor <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select asp-for="ProveedorId" class="form-select" required
                            aria-describedby="proveedor-error"
                            aria-invalid="@(ViewData.ModelState["ProveedorId"]?.Errors.Count > 0 ? "true" : "false")">
                        <option value="">-- Seleccione proveedor --</option>
                        @foreach (var item in ViewBag.Proveedores as IEnumerable<SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    @if (puedeCrearProveedor)
                    {
                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalNuevoProveedor">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i> Nuevo
                        </button>
                    }
                </div>
                <span asp-validation-for="ProveedorId" id="proveedor-error" class="text-danger"></span>
            </div>
            <div class="col-md-6 col-xl-4 mb-3">
                <label asp-for="NumeroFactura" class="form-label fw-bold">Nº Factura / Guía</label>
                <input asp-for="NumeroFactura" class="form-control" placeholder="Opcional" />
            </div>
            <div class="col-md-6 col-xl-4 mb-3">
                <label asp-for="Evidencia" class="form-label fw-bold">Evidencia (foto)</label>
                <input asp-for="Evidencia" type="file" class="form-control" accept="image/*" />
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
            <button type="submit" class="btn btn-primary" id="btnRegistrarEntrada"><i class="bi bi-save"></i> Registrar Entrada</button>
        </div>
    </form>

    <p class="visually-hidden" aria-live="polite" id="avisoProveedor"></p>
</div>

@if (puedeCrearProveedor)
{
    <div class="modal fade" id="modalNuevoProveedor" tabindex="-1" aria-labelledby="tituloNuevoProveedor" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formNuevoProveedor" novalidate>
                    <div class="modal-header bg-success text-white">
                        <h2 class="modal-title fs-5" id="tituloNuevoProveedor"><i class="bi bi-truck" aria-hidden="true"></i> Registrar nuevo proveedor</h2>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" role="alert" tabindex="-1" id="errorGeneralProveedor"></div>
                        <div class="mb-3">
                            <label class="form-label" for="provNombre">Nombre o razón social <span class="text-danger" aria-hidden="true">*</span></label>
                            <input type="text" id="provNombre" name="Nombre" class="form-control" maxlength="150" required aria-required="true" data-campo="Nombre" />
                            <div class="invalid-feedback" id="provNombre-error"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="provRuc">RUC <span class="text-danger" aria-hidden="true">*</span></label>
                            <input type="text" id="provRuc" name="Documento" class="form-control" inputmode="numeric" maxlength="11"
                                   autocomplete="off" required aria-required="true" aria-describedby="provRuc-ayuda"
                                   data-ayuda="provRuc-ayuda" data-campo="Documento" />
                            <div class="form-text" id="provRuc-ayuda">11 dígitos, solo números.</div>
                            <div class="invalid-feedback" id="provRuc-error"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="provContacto">Contacto <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="text" id="provContacto" name="Contacto" class="form-control" maxlength="100" data-campo="Contacto" />
                            <div class="invalid-feedback" id="provContacto-error"></div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label" for="provDireccion">Dirección <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="text" id="provDireccion" name="Direccion" class="form-control" maxlength="200" data-campo="Direccion" />
                            <div class="invalid-feedback" id="provDireccion-error"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" id="btnGuardarProveedor"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar proveedor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Json.Serialize escapa < > & para que un nombre con una etiqueta de cierre de script no rompa el bloque
        var productos = @Json.Serialize(
                    ((IEnumerable<SelectListItem>)ViewBag.Productos).Select(p => new { value = p.Value, text = p.Text }));
        var ubicaciones = @Json.Serialize((object)ViewBag.Ubicaciones);
        // { idProducto: [{ u: idUbicacion, c: cantidad }] } de las zonas que ve el usuario
        var stockPorProducto = @Json.Serialize((object)ViewBag.StockPorProducto);
        const ubicacionPorId = new Map(ubicaciones.map(u => [u.value, u]));

        // Los nombres vienen de la BD: escaparlos antes de meterlos en HTML
        function escaparHtml(texto) {
            return String(texto)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        let contadorFila = 0;
        const tbodyProductos = document.querySelector('#tablaProductos tbody');
        const estadoVacio = document.getElementById('estadoVacio');
        const btnRegistrarEntrada = document.getElementById('btnRegistrarEntrada');

        function actualizarEstadoCarrito() {
            const hayFilas = tbodyProductos.children.length > 0;
            estadoVacio.style.display = hayFilas ? 'none' : 'block';
            btnRegistrarEntrada.disabled = !hayFilas;
        }

        function agregarFila() {
            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>
                    <select name="Detalles[${contadorFila}].ProductoId" class="form-select" required>
                        <option value="">-- Seleccione producto --</option>
                        ${productos.map(p => `<option value="${escaparHtml(p.value)}">${escaparHtml(p.text)}</option>`).join('')}
                    </select>
                </td>
                <td>
                    <select name="Detalles[${contadorFila}].UbicacionId" class="form-select" required
                            aria-describedby="pistaUbicacion${contadorFila}">
                        <option value="">-- Seleccione ubicación --</option>
                        ${ubicaciones.map(u => `<option value="${escaparHtml(u.value)}">${escaparHtml(u.text)}</option>`).join('')}
                    </select>
                    <small class="text-muted d-block mt-1" id="pistaUbicacion${contadorFila}" aria-live="polite"></small>
                </td>
                <td>
                    <input type="number" name="Detalles[${contadorFila}].Cantidad" class="form-control" min="1" required>
                </td>
                <td>
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)" aria-label="Quitar producto">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            tbodyProductos.appendChild(fila);

            const selProducto = fila.querySelector('select[name$=".ProductoId"]');
            const selUbicacion = fila.querySelector('select[name$=".UbicacionId"]');
            const pista = fila.querySelector(`#pistaUbicacion${contadorFila}`);
            selProducto.addEventListener('change', () => sugerirUbicacion(selUbicacion, selProducto.value, pista));
            selUbicacion.addEventListener('change', () => {
                selUbicacion.dataset.elegidaPorUsuario = '1';
                pista.textContent = '';
            });

            contadorFila++;
            actualizarEstadoCarrito();
        }

        function nuevaOpcion(valor, texto) {
            const o = document.createElement('option');
            o.value = valor;
            o.textContent = texto;
            return o;
        }

        function grupoOpciones(etiqueta, opciones) {
            const g = document.createElement('optgroup');
            g.label = etiqueta;
            g.append(...opciones);
            return g;
        }

        // Ordena las zonas para el producto elegido y sugiere dónde recibirlo: donde ya está y queda
        // menos (para reponer ahí) o, si no está en ninguna zona, en Recepción.
        function sugerirUbicacion(select, productoId, pista) {
            const enZonas = (stockPorProducto[productoId] || [])
                .filter(s => ubicacionPorId.has(String(s.u)))
                .sort((a, b) => a.c - b.c);
            const idsConProducto = new Set(enZonas.map(s => String(s.u)));
            const recepcion = ubicaciones.filter(u => u.recepcion && !idsConProducto.has(u.value));
            const otras = ubicaciones.filter(u => !u.recepcion && !idsConProducto.has(u.value));
            const previa = select.value;

            select.replaceChildren(nuevaOpcion('', '-- Seleccione ubicación --'));
            if (enZonas.length)
                select.append(grupoOpciones('Donde ya está este producto',
                    enZonas.map(s => nuevaOpcion(String(s.u), `${ubicacionPorId.get(String(s.u)).text} · quedan ${s.c}`))));
            if (recepcion.length)
                select.append(grupoOpciones('Recepción', recepcion.map(u => nuevaOpcion(u.value, u.text))));
            if (otras.length)
                select.append(grupoOpciones('Otras zonas', otras.map(u => nuevaOpcion(u.value, u.text))));

            if (select.dataset.elegidaPorUsuario === '1' && previa) {
                select.value = previa;
                return;
            }

            if (enZonas.length) {
                const zona = ubicacionPorId.get(String(enZonas[0].u));
                select.value = zona.value;
                pista.textContent = `Sugerido: donde ya está (quedan ${enZonas[0].c}). Puedes cambiarlo.`;
            } else if (recepcion.length) {
                select.value = recepcion[0].value;
                pista.textContent = 'Sugerido: Recepción, porque no hay este producto en ninguna zona.';
            } else {
                pista.textContent = '';
            }
        }

        function eliminarFila(boton) {
            boton.closest('tr').remove();
            actualizarEstadoCarrito();
        }

        document.getElementById('btnAgregarFila').addEventListener('click', agregarFila);

        document.addEventListener('DOMContentLoaded', () => {
            actualizarEstadoCarrito();
            document.getElementById('resumenErrores')?.focus();
        });

        // ======= NUEVO PROVEEDOR (modal, sin recargar para no perder el carrito) =======
        const formProveedor = document.getElementById('formNuevoProveedor');
        if (formProveedor) {
            const modalProveedor = document.getElementById('modalNuevoProveedor');
            const btnGuardarProveedor = document.getElementById('btnGuardarProveedor');
            const errorGeneral = document.getElementById('errorGeneralProveedor');
            const contenidoBotonProveedor = btnGuardarProveedor.innerHTML;
            const camposProveedor = [...formProveedor.querySelectorAll('[data-campo]')];

            function limpiarErroresProveedor() {
                errorGeneral.classList.add('d-none');
                errorGeneral.textContent = '';
                camposProveedor.forEach(input => {
                    input.classList.remove('is-invalid');
                    input.removeAttribute('aria-invalid');
                    document.getElementById(input.id + '-error').textContent = '';
                    if (input.dataset.ayuda) input.setAttribute('aria-describedby', input.dataset.ayuda);
                    else input.removeAttribute('aria-describedby');
                });
            }

            function mostrarErroresProveedor(errores) {
                let primero = null;
                for (const [campo, mensaje] of Object.entries(errores)) {
                    const input = camposProveedor.find(i => i.dataset.campo === campo);
                    if (!input) {
                        errorGeneral.textContent = mensaje;
                        errorGeneral.classList.remove('d-none');
                        primero ??= errorGeneral;
                        continue;
                    }
                    const idError = input.id + '-error';
                    input.classList.add('is-invalid');
                    input.setAttribute('aria-invalid', 'true');
                    input.setAttribute('aria-describedby', [input.dataset.ayuda, idError].filter(Boolean).join(' '));
                    document.getElementById(idError).textContent = mensaje;
                    primero ??= input;
                }
                primero?.focus();
            }

            formProveedor.addEventListener('submit', async function (e) {
                e.preventDefault();
                limpiarErroresProveedor();

                const datos = new FormData(formProveedor);
                datos.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                btnGuardarProveedor.disabled = true;
                btnGuardarProveedor.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Guardando…';
                try {
                    const respuesta = await fetch('@Url.Action("CrearRapido", "Proveedor")', { method: 'POST', body: datos });
                    const resultado = await respuesta.json();
                    if (resultado.success) {
                        const select = document.getElementById('ProveedorId');
                        select.add(new Option(resultado.nombre, resultado.id, true, true));
                        select.setAttribute('aria-invalid', 'false');
                        document.getElementById('proveedor-error').textContent = '';
                        bootstrap.Modal.getInstance(modalProveedor).hide();
                        document.getElementById('avisoProveedor').textContent = `Proveedor ${resultado.nombre} registrado y seleccionado.`;
                    } else {
                        mostrarErroresProveedor(resultado.errores || {});
                    }
                } catch {
                    // También cae aquí si la sesión expiró (la respuesta es la página de login, no JSON)
                    mostrarErroresProveedor({ '': 'No se pudo registrar el proveedor. Revisa tu conexión o vuelve a iniciar sesión.' });
                } finally {
                    btnGuardarProveedor.disabled = false;
                    btnGuardarProveedor.innerHTML = contenidoBotonProveedor;
                }
            });

            modalProveedor.addEventListener('shown.bs.modal', () => document.getElementById('provNombre').focus());
            modalProveedor.addEventListener('hidden.bs.modal', () => {
                formProveedor.reset();
                limpiarErroresProveedor();
            });
        }
    </script>
}