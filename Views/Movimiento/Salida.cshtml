@model GestionAlmacen_Golocentro.ViewModels.SalidaCarritoViewModel
@{
    ViewData["Title"] = "Registrar Salida - Punto de Venta";
}

<div class="container-fluid">
    <h2 class="mb-3"><i class="bi bi-cart3"></i> Registrar Salida de Productos</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-action="Salida" enctype="multipart/form-data" id="formSalida">
        @Html.AntiForgeryToken()

        <!-- Fila superior: Cliente y Comprobante -->
        <div class="row mb-3">
            <div class="col-md-5">
                <label class="form-label fw-bold">Cliente <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select asp-for="ClienteId" class="form-select" id="selectCliente" required>
                        <option value="">-- Seleccione un cliente --</option>
                        @if (ViewBag.Clientes != null)
                        {
                            @foreach (var c in ViewBag.Clientes)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        }
                    </select>
                    <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalNuevoCliente" title="Registrar nuevo cliente">
                        <i class="bi bi-plus-circle"></i> Nuevo
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="NumeroComprobante" class="form-label fw-bold">Nº Comprobante</label>
                <input asp-for="NumeroComprobante" class="form-control" placeholder="Opcional" />
            </div>
            <div class="col-md-3">
                <label asp-for="Evidencia" class="form-label fw-bold">Evidencia</label>
                <input asp-for="Evidencia" type="file" class="form-control" accept="image/*" />
            </div>
        </div>

        <!-- Búsqueda rápida de producto -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold"><i class="bi bi-search"></i> Buscar producto</label>
                <input type="text" id="buscarProducto" class="form-control" placeholder="Escriba nombre o código del producto..." autocomplete="off" />
                <div id="resultadosBusqueda" class="list-group mt-1" style="position:absolute; z-index:1000; max-height:200px; overflow-y:auto; display:none;"></div>
            </div>
        </div>

        <!-- Tabla del carrito -->
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="bi bi-cart-check"></i> Productos en el carrito
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="tablaCarrito">
                        <thead class="table-secondary">
                            <tr>
                                <th>Producto</th>
                                <th>Ubicación</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center" style="width:100px;">Cantidad</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="carritoBody">
                            <!-- Las filas se agregan dinámicamente con JavaScript -->
                        </tbody>
                        <tfoot>
                            <tr class="table-dark fw-bold">
                                <td colspan="5" class="text-end">TOTAL GENERAL:</td>
                                <td class="text-end" id="totalGeneral">S/. 0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary btn-lg"><i class="bi bi-arrow-left"></i> Cancelar</a>
            <button type="submit" class="btn btn-warning btn-lg"><i class="bi bi-save"></i> Registrar Salida</button>
        </div>
    </form>
</div>

<!-- Modal: Nuevo Cliente Rápido (SIN AJAX) -->
<div class="modal fade" id="modalNuevoCliente" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CrearClienteRapido" asp-controller="Movimiento">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> Registrar Nuevo Cliente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre o Razón Social <span class="text-danger">*</span></label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">RUC / DNI</label>
                        <input type="text" name="RucDni" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contacto</label>
                        <input type="text" name="Contacto" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="Direccion" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Guardar Cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Datos desde el servidor
        var productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Productos ?? new List<object>()));
        var ubicaciones = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Ubicaciones ?? new List<object>()));

        let contadorItems = 0;
        const carritoBody = document.getElementById('carritoBody');
        const totalSpan = document.getElementById('totalGeneral');

        // ======= BÚSQUEDA DE PRODUCTOS =======
        const buscarInput = document.getElementById('buscarProducto');
        const resultadosDiv = document.getElementById('resultadosBusqueda');

        buscarInput.addEventListener('input', function() {
            const texto = this.value.toLowerCase().trim();
            if (texto.length < 1) {
                resultadosDiv.style.display = 'none';
                return;
            }
            const filtrados = productos.filter(p =>
                p.nombre.toLowerCase().includes(texto) || p.codigo.toLowerCase().includes(texto)
            );
            if (filtrados.length > 0) {
                resultadosDiv.innerHTML = filtrados.slice(0, 5).map(p =>
                    `<a href="#" class="list-group-item list-group-item-action" onclick="seleccionarProducto(${p.id}, '${p.nombre.replace(/'/g, "\\'")}', ${p.precio}); return false;">
                        <strong>${p.nombre}</strong> <small class="text-muted">${p.codigo}</small> - S/. ${p.precio.toFixed(2)}
                    </a>`
                ).join('');
                resultadosDiv.style.display = 'block';
            } else {
                resultadosDiv.innerHTML = '<div class="list-group-item text-muted">No se encontraron productos</div>';
                resultadosDiv.style.display = 'block';
            }
        });

        document.addEventListener('click', function(e) {
            if (!buscarInput.contains(e.target) && !resultadosDiv.contains(e.target)) {
                resultadosDiv.style.display = 'none';
            }
        });

        // ======= AGREGAR PRODUCTO AL CARRITO =======
        function seleccionarProducto(id, nombre, precio) {
            resultadosDiv.style.display = 'none';
            buscarInput.value = '';
            agregarFilaCarrito(id, nombre, precio);
        }

        function agregarFilaCarrito(productoId, nombreProducto, precioUnitario) {
            const ubicacionOptions = ubicaciones.map(u =>
                `<option value="${u.id}">${u.codigo}</option>`
            ).join('');

            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>
                    <input type="hidden" name="Items[${contadorItems}].ProductoId" value="${productoId}" />
                    <input type="hidden" name="Items[${contadorItems}].NombreProducto" value="${nombreProducto}" />
                    <strong>${nombreProducto}</strong>
                </td>
                <td>
                    <select name="Items[${contadorItems}].UbicacionId" class="form-select form-select-sm" onchange="actualizarStock(this, ${productoId})">
                        <option value="">-- Ubicación --</option>
                        ${ubicacionOptions}
                    </select>
                    <small class="text-muted stock-info" style="display:none;"></small>
                </td>
                <td class="text-center stock-disponible">-</td>
                <td>
                    <input type="number" name="Items[${contadorItems}].Cantidad"
                           class="form-control form-control-sm cantidad-input"
                           min="1" value="1"
                           onchange="calcularSubtotal(this, ${precioUnitario})" />
                </td>
                <td class="text-end">
                    <input type="hidden" name="Items[${contadorItems}].PrecioUnitario" value="${precioUnitario}" />
                    S/. ${precioUnitario.toFixed(2)}
                </td>
                <td class="text-end subtotal">S/. ${precioUnitario.toFixed(2)}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)" title="Quitar producto">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            carritoBody.appendChild(fila);
            contadorItems++;
            actualizarTotalGeneral();
        }

        // ======= ACTUALIZAR STOCK AL CAMBIAR UBICACIÓN =======
        async function actualizarStock(selectElement, productoId) {
            const ubicacionId = selectElement.value;
            const fila = selectElement.closest('tr');
            const stockCell = fila.querySelector('.stock-disponible');
            const stockInfo = fila.querySelector('.stock-info');
            const cantidadInput = fila.querySelector('.cantidad-input');

            if (!ubicacionId) {
                stockCell.textContent = '-';
                stockInfo.style.display = 'none';
                return;
            }

            try {
                const response = await fetch(`/Movimiento/ObtenerStock?productoId=${productoId}&ubicacionId=${ubicacionId}`);
                const data = await response.json();
                stockCell.textContent = data.stock;
                cantidadInput.max = data.stock;
                stockInfo.textContent = `Disponible: ${data.stock}`;
                stockInfo.style.display = 'block';
            } catch {
                stockCell.textContent = '?';
            }
        }

        // ======= CALCULAR SUBTOTAL Y TOTAL GENERAL =======
        function calcularSubtotal(inputElement, precioUnitario) {
            const cantidad = parseInt(inputElement.value) || 1;
            const fila = inputElement.closest('tr');
            const subtotalCell = fila.querySelector('.subtotal');
            const subtotal = cantidad * precioUnitario;
            subtotalCell.textContent = `S/. ${subtotal.toFixed(2)}`;
            actualizarTotalGeneral();
        }

        function actualizarTotalGeneral() {
            let total = 0;
            document.querySelectorAll('.subtotal').forEach(cell => {
                const valor = parseFloat(cell.textContent.replace('S/. ', '')) || 0;
                total += valor;
            });
            totalSpan.textContent = `S/. ${total.toFixed(2)}`;
            document.getElementById('TotalGeneral').value = total.toFixed(2);
        }

        function eliminarFila(boton) {
            boton.closest('tr').remove();
            actualizarTotalGeneral();
        }

        // ======= REGISTRAR NUEVO CLIENTE (AJAX) =======
        document.getElementById('btnGuardarCliente').addEventListener('click', async function() {
            const nombre = document.getElementById('clienteNombre').value.trim();
            if (!nombre) {
                alert('El nombre del cliente es obligatorio.');
                return;
            }
            const formData = new FormData();
            formData.append('Nombre', nombre);
            formData.append('RucDni', document.getElementById('clienteRucDni').value.trim());
            formData.append('Contacto', document.getElementById('clienteContacto').value.trim());
            formData.append('Direccion', document.getElementById('clienteDireccion').value.trim());

            try {
                const response = await fetch('/Movimiento/CrearClienteRapido', {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                const result = await response.json();
                if (result.success) {
                    const selectCliente = document.getElementById('selectCliente');
                    const option = new Option(result.nombre, result.clienteId);
                    selectCliente.add(option);
                    selectCliente.value = result.clienteId;
                    // Cerrar modal
                    bootstrap.Modal.getInstance(document.getElementById('modalNuevoCliente')).hide();
                    // Limpiar formulario
                    document.getElementById('formNuevoCliente').reset();
                } else {
                    alert('Error: ' + (result.errors ? result.errors.join(', ') : 'No se pudo registrar el cliente.'));
                }
            } catch {
                alert('Error de conexión al registrar el cliente.');
            }
        });

        // ======= INICIALIZAR =======
        document.addEventListener('DOMContentLoaded', function() {
            // El carrito empieza vacío; el usuario agrega productos con la búsqueda
        });
    </script>
}