@{
    ViewData["Title"] = "Dashboard";
    var nombre = ViewBag.NombreCompleto as string ?? "";
    var rol = ViewBag.Rol as string ?? "";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 18 ? "Buenas tardes" : "Buenas noches";
}

<style>
    /* ── Métricas ── */
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .metric-card {
        background: #fff;
        border: 1px solid rgba(230,232,234,0.2);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.15s, box-shadow 0.15s;
    }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(15,23,42,0.08);
        }

    .metric-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 24px;
    }

        .metric-icon.entrada {
            background: rgba(4,120,87,0.1);
            color: #047857;
        }

        .metric-icon.salida {
            background: rgba(230,232,234,0.2);
            color: #065F46;
        }

        .metric-icon.alerta {
            background: rgba(220,38,38,0.1);
            color: #DC2626;
        }

    .metric-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .metric-value {
        font-size: 32px;
        font-weight: 600;
        color: #334155;
        line-height: 1;
    }

    .metric-sub {
        font-size: 11px;
        color: #94A3B8;
        margin-top: 3px;
    }

    /* ── Acciones rápidas ── */
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .action-card {
        background: #fff;
        border: 1px solid rgba(230,232,234,0.2);
        border-radius: 14px;
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        transition: all 0.18s;
        cursor: pointer;
    }

        .action-card:hover {
            background: #334155;
            border-color: #334155;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(15,23,42,0.2);
        }

            .action-card:hover .action-icon {
                background: rgba(255,255,255,0.15);
                color: #FFFFFF;
            }

            .action-card:hover .action-label {
                color: #FFFFFF;
            }

            .action-card:hover .action-sub {
                color: rgba(255,255,255,0.6);
            }

    .action-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(4,120,87,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #047857;
        transition: all 0.18s;
    }

    .action-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        text-align: center;
        transition: color 0.18s;
    }

    .action-sub {
        font-size: 11px;
        color: #475569;
        text-align: center;
        transition: color 0.18s;
    }

    /* ── Tablas inferiores ── */
    .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .table-card {
        background: #fff;
        border: 1px solid rgba(230,232,234,0.2);
        border-radius: 14px;
        overflow: hidden;
    }

    .table-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(230,232,234,0.15);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .table-card-header i {
            font-size: 17px;
            color: #047857;
        }

        .table-card-header span {
            font-size: 14px;
            font-weight: 600;
            color: #334155;
            flex: 1;
        }

        .table-card-header a {
            font-size: 12px;
            color: #475569;
            text-decoration: none;
            font-weight: 500;
        }

            .table-card-header a:hover {
                color: #047857;
            }

    .mov-table {
        width: 100%;
        border-collapse: collapse;
    }

        .mov-table th {
            font-size: 11px;
            font-weight: 600;
            color: #475569;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 8px 1.25rem;
            background: #F8FAFC;
            border-bottom: 1px solid rgba(230,232,234,0.15);
        }

        .mov-table td {
            padding: 10px 1.25rem;
            font-size: 13px;
            color: #0F172A;
            border-bottom: 1px solid rgba(230,232,234,0.1);
            vertical-align: middle;
        }

        .mov-table tr:last-child td {
            border-bottom: none;
        }

        .mov-table tr:hover td {
            background: #F8FAFC;
        }

    .empty-row td {
        text-align: center;
        color: #94A3B8;
        padding: 2rem;
        font-size: 13px;
    }

    /* Badges */
    .badge-entrada {
        background: rgba(4,120,87,0.12);
        color: #047857;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .badge-salida {
        background: rgba(220,38,38,0.1);
        color: #DC2626;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .badge-stock {
        background: rgba(230,150,0,0.12);
        color: #b37a00;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .badge-venc {
        background: rgba(230,232,234,0.2);
        color: #065F46;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    /* Saludo */
    .dash-greeting {
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

        .dash-greeting h2 {
            font-size: 20px;
            font-weight: 600;
            color: #334155;
            margin: 0;
        }

        .dash-greeting p {
            font-size: 13px;
            color: #475569;
            margin: 2px 0 0;
        }

    .dash-date {
        background: #fff;
        border: 1px solid rgba(230,232,234,0.2);
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 12px;
        color: #475569;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    @@media (max-width: 900px) {
        .metric-grid {
            grid-template-columns: 1fr 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr 1fr;
        }

        .bottom-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .metric-grid {
            grid-template-columns: 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<!-- Saludo -->
<div class="dash-greeting">
    <div>
        <h2>@saludo, @nombre 👋</h2>
        <p>
            <span class="badge-entrada" style="font-size:12px">@rol</span>
            &nbsp;· Resumen del día
        </p>
    </div>
    <div class="dash-date">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-PE"))
    </div>
</div>

<!-- Métricas -->
<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon entrada">
            <i class="bi bi-box-arrow-in-down"></i>
        </div>
        <div>
            <div class="metric-label">Entradas hoy</div>
            <div class="metric-value">@(ViewBag.EntradasHoy ?? 0)</div>
            <div class="metric-sub">Ingresos registrados</div>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon salida">
            <i class="bi bi-box-arrow-up"></i>
        </div>
        <div>
            <div class="metric-label">Salidas hoy</div>
            <div class="metric-value">@(ViewBag.SalidasHoy ?? 0)</div>
            <div class="metric-sub">Despachos realizados</div>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon alerta">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div>
            <div class="metric-label">Alertas activas</div>
            <div class="metric-value">@(ViewBag.AlertasActivas ?? 0)</div>
            <div class="metric-sub">Stock bajo o por vencer</div>
        </div>
    </div>
</div>

<!-- Acciones rápidas -->
<div class="actions-grid">
    <a class="action-card"
       asp-controller="Movimiento" asp-action="Entrada">
        <div class="action-icon"><i class="bi bi-package-import" style="font-size:22px"></i></div>
        <div class="action-label">Nueva Entrada</div>
        <div class="action-sub">Registrar ingreso</div>
    </a>
    <a class="action-card"
       asp-controller="Movimiento" asp-action="Salida">
        <div class="action-icon"><i class="bi bi-package-export" style="font-size:22px"></i></div>
        <div class="action-label">Nueva Salida</div>
        <div class="action-sub">Registrar despacho</div>
    </a>
    <a class="action-card"
       asp-controller="Producto" asp-action="Stock">
        <div class="action-icon"><i class="bi bi-bar-chart-line"></i></div>
        <div class="action-label">Ver Stock</div>
        <div class="action-sub">Consultar inventario</div>
    </a>
    <a class="action-card"
       asp-controller="Alerta" asp-action="Index">
        <div class="action-icon"><i class="bi bi-bell"></i></div>
        <div class="action-label">Ver Alertas</div>
        <div class="action-sub">@(ViewBag.AlertasActivas ?? 0) pendientes</div>
    </a>
</div>

<!-- Últimos movimientos + Últimas alertas -->
<div class="bottom-grid">

    <!-- Movimientos -->
    <div class="table-card">
        <div class="table-card-header">
            <i class="bi bi-clock-history"></i>
            <span>Últimos Movimientos</span>
            <a asp-controller="Movimiento" asp-action="Index">Ver todos →</a>
        </div>
        <table class="mov-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Usuario</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.UltimosMovimientos != null)
                {
                    foreach (var mov in ViewBag.UltimosMovimientos)
                    {
                        <tr>
                            <td style="color:#475569; font-size:12px">
                                @mov.Fecha.ToString("dd/MM HH:mm")
                            </td>
                            <td>
                                @if (mov.Tipo == "Entrada")
                                {
                                    <span class="badge-entrada">Entrada</span>
                                }
                                else
                                {
                                    <span class="badge-salida">Salida</span>
                                }
                            </td>
                            <td style="font-weight:500">
                                @mov.IdUsuarioNavigation?.Nombre
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="3">
                            <i class="bi bi-inbox" style="font-size:20px;display:block;margin-bottom:6px"></i>
                            No hay movimientos recientes
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Alertas -->
    <div class="table-card">
        <div class="table-card-header">
            <i class="bi bi-exclamation-triangle" style="color:#DC2626"></i>
            <span>Últimas Alertas</span>
            <a asp-controller="Alerta" asp-action="Index">Ver todas →</a>
        </div>
        <table class="mov-table">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Mensaje</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.UltimasAlertas != null)
                {
                    foreach (var alerta in ViewBag.UltimasAlertas)
                    {
                        string tipoMostrar = alerta.Tipo switch
                        {
                            "stock_minimo" => "Stock Bajo",
                            "vencimiento" => "Vencimiento",
                            _ => alerta.Tipo
                        };
                        bool esStock = alerta.Tipo == "stock_minimo";

                        <tr>
                            <td>
                                @if (esStock)
                                {
                                    <span class="badge-stock">@tipoMostrar</span>
                                }
                                else
                                {
                                    <span class="badge-venc">@tipoMostrar</span>
                                }
                            </td>
                            <td style="font-size:12px; color:#0F172A">@alerta.Mensaje</td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="2">
                            <i class="bi bi-check-circle" style="font-size:20px;display:block;margin-bottom:6px;color:#475569"></i>
                            Sin alertas pendientes
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
