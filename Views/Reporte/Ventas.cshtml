@using System.Globalization
@using GestionAlmacen_Golocentro.ViewModels
@model ReporteVentasViewModel
@{
    ViewData["Title"] = "Reporte de ventas";
    var inv = CultureInfo.InvariantCulture;
    string Soles(decimal n) => "S/ " + n.ToString("N2", inv);
    var f = Model.Filtro;
    var todasLasSedes = f.SedeId == null && f.Sedes.Count > 1;

    // Eje del gráfico: tope "redondo" (1, 2, 2.5 o 5 × 10^n) y 4 divisiones
    var maximo = Model.PorPeriodo.Count == 0 ? 0 : Model.PorPeriodo.Max(p => p.Total);
    decimal tope = 10;
    if (maximo > 0)
    {
        var potencia = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)maximo)));
        var fraccion = maximo / potencia;
        tope = (fraccion <= 1 ? 1 : fraccion <= 2 ? 2 : fraccion <= 2.5m ? 2.5m : fraccion <= 5 ? 5 : 10) * potencia;
    }
    var marcas = Enumerable.Range(0, 5).Select(i => tope * i / 4).ToList();
    string Marca(decimal v) => v.ToString(v % 1 == 0 ? "N0" : "N2", inv);
    // Etiquetas del eje X: unas 8 como máximo, siempre la primera y la última
    var n = Model.PorPeriodo.Count;
    var paso = Math.Max(1, (int)Math.Ceiling(n / 8.0));
    var mejor = Model.PorPeriodo.OrderByDescending(p => p.Total).FirstOrDefault();
    var descripcionGrafico = Model.Ventas == 0
        ? "Sin ventas en el periodo."
        : $"Ventas {(Model.PorMes ? "por mes" : "por día")}: el mayor fue {mejor!.EtiquetaLarga} con {Soles(mejor.Total)}. El detalle está en la tabla que sigue al gráfico.";
}

@await Html.PartialAsync("_EstilosReporte")

<style>
    .rp-grafico {
        margin: 0;
        padding: 12px 1.25rem 16px;
    }

    .rp-area {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 8px;
        height: 220px;
    }

    .rp-eje-y {
        position: relative;
        width: 64px;
        font-size: 12px;
        color: var(--g-muted);
        font-variant-numeric: tabular-nums;
    }

        .rp-eje-y span {
            position: absolute;
            right: 0;
            transform: translateY(50%);
            white-space: nowrap;
        }

    .rp-plot {
        position: relative;
        border-bottom: 1px solid #CBD5E1;
    }

    .rp-linea {
        position: absolute;
        left: 0;
        right: 0;
        border-top: 1px solid #EEF2F6;
    }

    .rp-columnas {
        position: absolute;
        inset: 0;
        display: flex;
        gap: 2px;
    }

    .rp-col {
        position: relative;
        flex: 1;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        min-width: 0;
    }

    .rp-dato {
        width: min(24px, 100%);
        background: var(--g-teal);
        border-radius: 4px 4px 0 0;
    }

    .rp-col:hover .rp-dato {
        background: #065F46;
    }

    .rp-col::after {
        content: attr(data-tip);
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translate(-50%, -100%);
        padding: 6px 10px;
        border-radius: 8px;
        background: var(--g-navy);
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        pointer-events: none;
        /* Oculto con display (no opacity): invisible también ocuparía espacio y movería la página */
        display: none;
        z-index: 2;
    }

    .rp-col.inicio::after {
        left: 0;
        transform: translate(0, -100%);
    }

    .rp-col.fin::after {
        left: auto;
        right: 0;
        transform: translate(0, -100%);
    }

    .rp-col:hover::after {
        display: block;
    }

    .rp-eje-x {
        display: flex;
        gap: 2px;
        margin-left: 72px;
        margin-top: 6px;
        font-size: 12px;
        color: var(--g-muted);
    }

        .rp-eje-x span {
            flex: 1;
            min-width: 0;
            text-align: center;
            white-space: nowrap;
            overflow: visible;
        }

            /* Los extremos se alinean al borde para no salirse del gráfico */
            .rp-eje-x span:first-child {
                text-align: left;
            }

            .rp-eje-x span:last-child {
                text-align: right;
            }

    .rp-detalle-dias summary {
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        color: var(--g-teal);
        padding: 0 1.25rem 12px;
    }

        .rp-detalle-dias summary:focus-visible {
            outline: 2px solid var(--g-teal);
            outline-offset: 2px;
        }

    .rp-detalle-dias .cp-tabla-wrap {
        margin-top: 0;
    }

</style>

<div class="cp-page rp-page">
    <a class="cp-volver" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Reportes</a>
    <div class="cp-header">
        <div>
            <h1><i class="bi bi-receipt" aria-hidden="true"></i> Reporte de ventas</h1>
            <p>@f.SedeNombre · @f.Periodo</p>
        </div>
    </div>

    @await Html.PartialAsync("_Filtro", f)

    <div class="rp-kpis">
        <div class="rp-kpi principal">
            <div class="rp-kpi-etiqueta">Total vendido</div>
            <div class="rp-kpi-valor">@Soles(Model.Total)</div>
            <div class="rp-kpi-sub">@Model.Ventas @(Model.Ventas == 1 ? "venta" : "ventas")</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Ticket promedio</div>
            <div class="rp-kpi-valor">@Soles(Model.TicketPromedio)</div>
            <div class="rp-kpi-sub">por venta</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Descuentos</div>
            <div class="rp-kpi-valor">@Soles(Model.Descuentos)</div>
            <div class="rp-kpi-sub">ya restados del total</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Anuladas</div>
            <div class="rp-kpi-valor">@Model.Anuladas</div>
            <div class="rp-kpi-sub">no suman en el total</div>
        </div>
    </div>

    <section class="rp-seccion" aria-labelledby="tituloGrafico">
        <div class="rp-seccion-cab">
            <h2 id="tituloGrafico">Ventas @(Model.PorMes ? "por mes" : "por día")</h2>
            <p>Total vendido en soles</p>
        </div>
        @if (Model.Ventas == 0)
        {
            <div class="cp-vacio">
                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                No hay ventas en este periodo para graficar.
            </div>
        }
        else
        {
        <figure class="rp-grafico">
            <div class="rp-area" role="img" aria-label="@descripcionGrafico">
                <div class="rp-eje-y" aria-hidden="true">
                    @foreach (var m in marcas)
                    {
                        <span style="bottom:@((m / tope * 100).ToString("0.##", inv))%">@Marca(m)</span>
                    }
                </div>
                <div class="rp-plot" aria-hidden="true">
                    @foreach (var m in marcas.Skip(1))
                    {
                        <div class="rp-linea" style="bottom:@((m / tope * 100).ToString("0.##", inv))%"></div>
                    }
                    <div class="rp-columnas">
                        @for (var i = 0; i < n; i++)
                        {
                            var p = Model.PorPeriodo[i];
                            // El globo se alinea al borde cercano para no salirse del gráfico
                            var clase = i < n / 3.0 ? "inicio" : i >= n * 2 / 3.0 ? "fin" : null;
                            <div class="rp-col @clase" data-tip="@p.EtiquetaLarga · @Soles(p.Total) · @p.Ventas @(p.Ventas == 1 ? "venta" : "ventas")">
                                @if (p.Total > 0)
                                {
                                    <span class="rp-dato" style="height:@((p.Total / tope * 100).ToString("0.##", inv))%"></span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="rp-eje-x" aria-hidden="true">
                @for (var i = 0; i < n; i++)
                {
                    <span>@(i % paso == 0 || i == n - 1 ? Model.PorPeriodo[i].Etiqueta : "")</span>
                }
            </div>
        </figure>
        }
        <details class="rp-detalle-dias rp-no-imprimir">
            <summary>Ver la tabla @(Model.PorMes ? "por mes" : "por día")</summary>
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">@(Model.PorMes ? "Mes" : "Día")</th>
                            <th scope="col" class="rp-num">Ventas</th>
                            <th scope="col" class="rp-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PorPeriodo)
                        {
                            <tr>
                                <td>@p.EtiquetaLarga</td>
                                <td class="rp-num">@p.Ventas</td>
                                <td class="rp-num">@Soles(p.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>

    <div class="rp-dos">
        <section class="rp-seccion" aria-labelledby="tituloMetodos">
            <div class="rp-seccion-cab">
                <h2 id="tituloMetodos">Por método de pago</h2>
                <p>Para cuadrar la caja</p>
            </div>
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Método</th>
                            <th scope="col" class="rp-num">Ventas</th>
                            <th scope="col" class="rp-num">Total</th>
                            <th scope="col">Parte</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PorMetodo.Count == 0)
                        {
                            <tr><td colspan="4" class="cp-mov-ninguno">Sin ventas en el periodo.</td></tr>
                        }
                        @foreach (var m in Model.PorMetodo)
                        {
                            var parte = Model.Total == 0 ? 0 : m.Total / Model.Total;
                            <tr>
                                <td class="cp-nombre">@m.Metodo</td>
                                <td class="rp-num">@m.Ventas</td>
                                <td class="rp-num">@Soles(m.Total)</td>
                                <td>
                                    <span class="rp-proporcion">
                                        <span><i style="width:@((parte * 100).ToString("0.#", inv))%"></i></span>
                                        <span>@((parte * 100).ToString("0", inv))%</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="rp-seccion" aria-labelledby="tituloVendedores">
            <div class="rp-seccion-cab">
                <h2 id="tituloVendedores">Por vendedor</h2>
                <p>Quién atendió cada venta</p>
            </div>
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Atendió</th>
                            <th scope="col" class="rp-num">Ventas</th>
                            <th scope="col" class="rp-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PorVendedor.Count == 0)
                        {
                            <tr><td colspan="3" class="cp-mov-ninguno">Sin ventas en el periodo.</td></tr>
                        }
                        @foreach (var v in Model.PorVendedor)
                        {
                            <tr>
                                <td class="cp-nombre">@v.Vendedor</td>
                                <td class="rp-num">@v.Ventas</td>
                                <td class="rp-num">@Soles(v.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="rp-seccion" aria-labelledby="tituloNotas">
        <div class="rp-seccion-cab">
            <h2 id="tituloNotas">Notas de venta</h2>
            <p>@Model.Filas.Count @(Model.Filas.Count == 1 ? "nota" : "notas")@(Model.Anuladas > 0 ? $", {Model.Anuladas} anulada{(Model.Anuladas == 1 ? "" : "s")}" : "")</p>
        </div>
        @if (Model.Filas.Count == 0)
        {
            <div class="cp-vacio">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                No hay ventas en este periodo.
            </div>
        }
        else
        {
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Nº</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Pago</th>
                            <th scope="col" class="rp-col-vendedor">Atendió</th>
                            @if (todasLasSedes)
                            {
                                <th scope="col" class="rp-col-sede">Sede</th>
                            }
                            <th scope="col" class="rp-num">Descuento</th>
                            <th scope="col" class="rp-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Filas)
                        {
                            <tr class="@(v.Anulada ? "rp-anulada" : null)">
                                <td>
                                    <a class="rp-enlace" asp-controller="Venta" asp-action="Nota" asp-route-id="@v.IdMovimiento">@v.Numero</a>
                                    @if (v.Anulada)
                                    {
                                        <span class="rp-estado anulada"><i class="bi bi-x-circle" aria-hidden="true"></i> Anulada</span>
                                    }
                                </td>
                                <td class="cp-doc">@v.Fecha.ToString("dd/MM HH:mm", inv)</td>
                                <td>@v.Cliente</td>
                                <td>@v.MetodoPago</td>
                                <td class="rp-col-vendedor">@v.Vendedor</td>
                                @if (todasLasSedes)
                                {
                                    <td class="rp-col-sede">@v.Sede</td>
                                }
                                <td class="rp-num">@(v.Descuento > 0 ? Soles(v.Descuento) : "—")</td>
                                <td class="rp-num">
                                    @if (v.Anulada)
                                    {
                                        <s>@Soles(v.Total)</s>
                                    }
                                    else
                                    {
                                        <span>@Soles(v.Total)</span>
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="rp-total">
                            <td colspan="@(todasLasSedes ? 6 : 5)">Total (sin anuladas)</td>
                            <td class="rp-num">@Soles(Model.Descuentos)</td>
                            <td class="rp-num">@Soles(Model.Total)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
