@using System.Globalization
@using GestionAlmacen_Golocentro.ViewModels
@model ReporteVentasViewModel
@{
    ViewData["Title"] = "Reporte de ventas";
    var inv = CultureInfo.InvariantCulture;
    string Soles(decimal n) => "S/ " + n.ToString("N2", inv);
    var f = Model.Filtro;
    var todasLasSedes = f.SedeId == null && f.Sedes.Count > 1;

    var mejor = Model.PorPeriodo.OrderByDescending(p => p.Total).FirstOrDefault();
    var descripcionGrafico = Model.Ventas == 0
        ? "Sin ventas en el periodo."
        : $"Ventas {(Model.PorMes ? "por mes" : "por día")}: el mayor fue {mejor!.EtiquetaLarga} con {Soles(mejor.Total)}. El detalle está en la tabla que sigue al gráfico.";
}

@await Html.PartialAsync("_EstilosReporte")


<div class="cp-page rp-page">
    <a class="cp-volver" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Reportes</a>
    <div class="cp-header">
        <div>
            <h1><i class="bi bi-receipt" aria-hidden="true"></i> Reporte de ventas</h1>
            <p>@f.SedeNombre · @f.Periodo</p>
        </div>
    </div>

    @await Html.PartialAsync("_Filtro", f)

    <div class="rp-kpis">
        <div class="rp-kpi principal">
            <div class="rp-kpi-etiqueta">Total vendido</div>
            <div class="rp-kpi-valor">@Soles(Model.Total)</div>
            <div class="rp-kpi-sub">@Model.Ventas @(Model.Ventas == 1 ? "venta" : "ventas")</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Ticket promedio</div>
            <div class="rp-kpi-valor">@Soles(Model.TicketPromedio)</div>
            <div class="rp-kpi-sub">por venta</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Descuentos</div>
            <div class="rp-kpi-valor">@Soles(Model.Descuentos)</div>
            <div class="rp-kpi-sub">ya restados del total</div>
        </div>
        <div class="rp-kpi">
            <div class="rp-kpi-etiqueta">Anuladas</div>
            <div class="rp-kpi-valor">@Model.Anuladas</div>
            <div class="rp-kpi-sub">no suman en el total</div>
        </div>
    </div>

    <section class="rp-seccion" aria-labelledby="tituloGrafico">
        <div class="rp-seccion-cab">
            <h2 id="tituloGrafico">Ventas @(Model.PorMes ? "por mes" : "por día")</h2>
            <p>Total vendido en soles</p>
        </div>
        @if (Model.Ventas == 0)
        {
            <div class="cp-vacio">
                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                No hay ventas en este periodo para graficar.
            </div>
        }
        else
        {
            @await Html.PartialAsync("_GraficoBarras", new GraficoPeriodos(Model.PorPeriodo, descripcionGrafico,
                Model.PorMes ? "por mes" : "por día", Model.PorMes ? "Mes" : "Día"))
        }
    </section>

    <div class="rp-dos">
        <section class="rp-seccion" aria-labelledby="tituloMetodos">
            <div class="rp-seccion-cab">
                <h2 id="tituloMetodos">Por método de pago</h2>
                <p>Para cuadrar la caja</p>
            </div>
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Método</th>
                            <th scope="col" class="rp-num">Ventas</th>
                            <th scope="col" class="rp-num">Total</th>
                            <th scope="col">Parte</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PorMetodo.Count == 0)
                        {
                            <tr><td colspan="4" class="cp-mov-ninguno">Sin ventas en el periodo.</td></tr>
                        }
                        @foreach (var m in Model.PorMetodo)
                        {
                            var parte = Model.Total == 0 ? 0 : m.Total / Model.Total;
                            <tr>
                                <td class="cp-nombre">@m.Metodo</td>
                                <td class="rp-num">@m.Ventas</td>
                                <td class="rp-num">@Soles(m.Total)</td>
                                <td>
                                    <span class="rp-proporcion">
                                        <span><i style="width:@((parte * 100).ToString("0.#", inv))%"></i></span>
                                        <span>@((parte * 100).ToString("0", inv))%</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="rp-seccion" aria-labelledby="tituloVendedores">
            <div class="rp-seccion-cab">
                <h2 id="tituloVendedores">Por vendedor</h2>
                <p>Quién atendió cada venta</p>
            </div>
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Atendió</th>
                            <th scope="col" class="rp-num">Ventas</th>
                            <th scope="col" class="rp-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PorVendedor.Count == 0)
                        {
                            <tr><td colspan="3" class="cp-mov-ninguno">Sin ventas en el periodo.</td></tr>
                        }
                        @foreach (var v in Model.PorVendedor)
                        {
                            <tr>
                                <td class="cp-nombre">@v.Vendedor</td>
                                <td class="rp-num">@v.Ventas</td>
                                <td class="rp-num">@Soles(v.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="rp-seccion" aria-labelledby="tituloNotas">
        <div class="rp-seccion-cab">
            <h2 id="tituloNotas">Notas de venta</h2>
            <p>@Model.Filas.Count @(Model.Filas.Count == 1 ? "nota" : "notas")@(Model.Anuladas > 0 ? $", {Model.Anuladas} anulada{(Model.Anuladas == 1 ? "" : "s")}" : "")</p>
        </div>
        @if (Model.Filas.Count == 0)
        {
            <div class="cp-vacio">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                No hay ventas en este periodo.
            </div>
        }
        else
        {
            <div class="cp-tabla-wrap">
                <table class="cp-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Nº</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Pago</th>
                            <th scope="col" class="rp-col-vendedor">Atendió</th>
                            @if (todasLasSedes)
                            {
                                <th scope="col" class="rp-col-sede">Sede</th>
                            }
                            <th scope="col" class="rp-num">Descuento</th>
                            <th scope="col" class="rp-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Filas)
                        {
                            <tr class="@(v.Anulada ? "rp-anulada" : null)">
                                <td>
                                    <a class="rp-enlace" asp-controller="Venta" asp-action="Nota" asp-route-id="@v.IdMovimiento">@v.Numero</a>
                                    @if (v.Anulada)
                                    {
                                        <span class="rp-estado anulada"><i class="bi bi-x-circle" aria-hidden="true"></i> Anulada</span>
                                    }
                                </td>
                                <td class="cp-doc">@v.Fecha.ToString("dd/MM HH:mm", inv)</td>
                                <td>@v.Cliente</td>
                                <td>@v.MetodoPago</td>
                                <td class="rp-col-vendedor">@v.Vendedor</td>
                                @if (todasLasSedes)
                                {
                                    <td class="rp-col-sede">@v.Sede</td>
                                }
                                <td class="rp-num">@(v.Descuento > 0 ? Soles(v.Descuento) : "—")</td>
                                <td class="rp-num">
                                    @if (v.Anulada)
                                    {
                                        <s>@Soles(v.Total)</s>
                                    }
                                    else
                                    {
                                        <span>@Soles(v.Total)</span>
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="rp-total">
                            <td colspan="@(todasLasSedes ? 6 : 5)">Total (sin anuladas)</td>
                            <td class="rp-num">@Soles(Model.Descuentos)</td>
                            <td class="rp-num">@Soles(Model.Total)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
