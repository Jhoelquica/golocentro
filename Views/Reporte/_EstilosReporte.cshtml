@await Html.PartialAsync("~/Views/Shared/_EstilosGestion.cshtml")

<style>
    .rp-page {
        max-width: 1180px;
    }

    /* Barra de filtros y acciones */
    .rp-barra {
        background: var(--g-white);
        border: 1px solid var(--g-border);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 1rem;
    }

    .rp-rangos {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

        .rp-rangos a {
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            padding: 6px 14px;
            border-radius: 999px;
            border: 1px solid var(--g-input-border);
            background: var(--g-white);
            font-size: 13px;
            font-weight: 600;
            color: var(--g-text);
            text-decoration: none;
        }

            .rp-rangos a:hover {
                border-color: var(--g-teal);
                color: var(--g-teal);
            }

            .rp-rangos a[aria-current="true"] {
                background: var(--g-teal);
                border-color: var(--g-teal);
                color: #FFFFFF;
            }

    .rp-fila-filtros {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
    }

    .rp-filtros {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 10px;
    }

    .rp-campo label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: var(--g-muted);
        margin-bottom: 4px;
    }

    .rp-campo input,
    .rp-campo select {
        height: 44px;
        padding: 0 10px;
        border: 1px solid var(--g-input-border);
        border-radius: 8px;
        font-size: 15px;
        font-family: inherit;
        color: var(--g-text);
        background: var(--g-white);
    }

        .rp-campo input:focus,
        .rp-campo select:focus {
            outline: none;
            border-color: var(--g-teal);
            box-shadow: 0 0 0 3px rgba(4,120,87,0.25);
        }

    .rp-acciones {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .rp-rangos a:focus-visible {
        outline: 2px solid var(--g-teal);
        outline-offset: 2px;
    }

    /* Cifras principales */
    .rp-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 12px;
        margin-bottom: 1rem;
    }

    .rp-kpi {
        background: var(--g-white);
        border: 1px solid var(--g-border);
        border-radius: 14px;
        padding: 14px 16px;
    }

        .rp-kpi.principal {
            border-color: rgba(4,120,87,0.35);
            background: rgba(4,120,87,0.04);
        }

    .rp-kpi-etiqueta {
        font-size: 12px;
        font-weight: 600;
        color: var(--g-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .rp-kpi-valor {
        font-size: 26px;
        font-weight: 700;
        color: var(--g-navy);
        line-height: 1.2;
        margin-top: 4px;
    }

    .rp-kpi.principal .rp-kpi-valor {
        font-size: 32px;
    }

    .rp-kpi-sub {
        font-size: 13px;
        color: var(--g-muted);
        margin-top: 2px;
    }

    /* Secciones */
    .rp-seccion {
        background: var(--g-white);
        border: 1px solid var(--g-border);
        border-radius: 14px;
        margin-bottom: 1rem;
        container-type: inline-size;
    }

    .rp-seccion-cab {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
        padding: 14px 1.25rem 0;
    }

        .rp-seccion-cab h2 {
            font-size: 16px;
            font-weight: 600;
            color: var(--g-navy);
            margin: 0;
        }

        .rp-seccion-cab p {
            font-size: 13px;
            color: var(--g-muted);
            margin: 0;
        }

    .rp-seccion .cp-tabla-wrap {
        margin-top: 10px;
    }

    .rp-dos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 16px;
    }

    @@media (max-width: 860px) {
        .rp-dos {
            grid-template-columns: 1fr;
        }
    }

    .rp-num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .rp-enlace {
        font-weight: 600;
        color: var(--g-teal);
        text-decoration: none;
        white-space: nowrap;
    }

        .rp-enlace:hover {
            text-decoration: underline;
        }

        .rp-enlace:focus-visible {
            outline: 2px solid var(--g-teal);
            outline-offset: 2px;
            border-radius: 4px;
        }

    .rp-total td {
        font-weight: 700;
        border-top: 2px solid var(--g-border);
    }

    .rp-nota-pie {
        font-size: 13px;
        color: var(--g-muted);
        padding: 10px 1.25rem 14px;
        margin: 0;
    }

    /* Barra de proporción dentro de la celda (magnitud, una sola serie) */
    .rp-proporcion {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 120px;
    }

        .rp-proporcion span:first-child {
            flex: 1;
            height: 8px;
            border-radius: 4px;
            background: var(--g-bg);
            overflow: hidden;
        }

        .rp-proporcion i {
            display: block;
            height: 100%;
            border-radius: 4px;
            background: var(--g-teal);
        }

        .rp-proporcion span:last-child {
            width: 48px;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    /* Estado (siempre con icono y texto, nunca solo color) */
    .rp-estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .rp-estado.sin_stock {
            background: rgba(220,38,38,0.1);
            color: var(--g-danger-text);
        }

        .rp-estado.bajo {
            background: rgba(245,158,11,0.16);
            color: #92400E;
        }

        .rp-estado.normal {
            background: rgba(4,120,87,0.1);
            color: var(--g-teal);
        }

        .rp-estado.anulada {
            background: rgba(220,38,38,0.1);
            color: var(--g-danger-text);
        }

    .rp-anulada td {
        color: var(--g-muted);
    }

    .rp-solo-imprimir {
        display: none;
    }

    /* Al imprimir: sin menú ni filtros, solo el reporte */
    @@media print {
        .g-sidebar, .g-topbar, .g-overlay, .rp-barra, .cp-volver, .rp-no-imprimir {
            display: none !important;
        }

        .g-main {
            margin: 0 !important;
            padding: 0 !important;
        }

        body {
            background: #FFFFFF !important;
        }

        .rp-solo-imprimir {
            display: block !important;
        }

        .rp-kpi, .rp-grafico {
            break-inside: avoid;
        }

        .cp-tabla-wrap {
            overflow: visible !important;
        }

        .cp-tabla {
            min-width: 0 !important;
        }

        .cp-tabla a {
            color: inherit;
            text-decoration: none;
        }
    }
</style>
