@{
    ViewData["Title"] = "Iniciar Sesión - Golocentro";
    Layout = null;
    var usuarioPrevio = ViewData["NombreUsuario"] as string ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: #334155;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
        }

            /* Decoración: fixed para que no genere scroll ni recorte la tarjeta en pantallas bajas */
            body::before, body::after {
                content: '';
                position: fixed;
                border-radius: 50%;
                pointer-events: none;
                z-index: 0;
            }

            body::before {
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, rgba(4,120,87,0.4) 0%, transparent 70%);
                top: -150px;
                right: -100px;
            }

            body::after {
                width: 400px;
                height: 400px;
                background: radial-gradient(circle, rgba(203,213,225,0.15) 0%, transparent 70%);
                bottom: -100px;
                left: -80px;
            }

        :focus-visible {
            outline: 2px solid #047857;
            outline-offset: 2px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 20px;
            width: 100%;
            max-width: 400px;
            overflow: hidden;
            position: relative;
            z-index: 1;
            box-shadow: 0 24px 60px rgba(0,0,0,0.35);
        }

        .login-header {
            background: #334155;
            padding: 2rem 2rem 1.75rem;
            text-align: center;
            border-bottom: 3px solid #047857;
        }

        .login-logo-wrap {
            width: 72px;
            height: 72px;
            background: #047857;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            box-shadow: 0 8px 20px rgba(4,120,87,0.5);
        }

            .login-logo-wrap i {
                font-size: 34px;
                color: #FFFFFF;
            }

        .login-header h1 {
            font-size: 22px;
            font-weight: 600;
            color: #FFFFFF;
            letter-spacing: 0.02em;
            margin-bottom: 4px;
        }

        .login-header p {
            font-size: 13px;
            color: #CBD5E1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .login-body {
            padding: 2rem;
        }

            .login-body h2 {
                font-size: 16px;
                font-weight: 600;
                color: #0F172A;
                margin-bottom: 1.5rem;
                text-align: center;
            }

        /* Error: #B91C1C sobre el fondo rosado da 5.5:1 (el rojo #DC2626 se quedaba en 4.1:1) */
        .alert-error {
            background: rgba(220,38,38,0.08);
            border: 1px solid rgba(220,38,38,0.3);
            border-radius: 10px;
            padding: 8px 8px 8px 14px;
            font-size: 13px;
            color: #B91C1C;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1.25rem;
        }

            .alert-error > i {
                font-size: 16px;
                flex-shrink: 0;
            }

            .alert-error .btn-close-error {
                margin-left: auto;
                background: none;
                border: none;
                color: #B91C1C;
                cursor: pointer;
                font-size: 18px;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .alert-error .btn-close-error:hover {
                    background: rgba(220,38,38,0.1);
                }

        .field-group {
            margin-bottom: 1rem;
        }

            .field-group label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: #475569;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                margin-bottom: 6px;
            }

        .field-input-wrap {
            position: relative;
        }

            .field-input-wrap > .field-icon {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 17px;
                color: #475569;
                pointer-events: none;
            }

            /* Borde #8492A6: 3.2:1 contra el blanco de la tarjeta (WCAG 1.4.11 pide 3:1) */
            .field-input-wrap input {
                width: 100%;
                height: 46px;
                padding: 0 12px 0 40px;
                border: 1px solid #8492A6;
                border-radius: 10px;
                font-size: 15px;
                color: #0F172A;
                font-family: inherit;
                background: #F8FAFC;
                transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
            }

                .field-input-wrap input:focus {
                    outline: none;
                    border-color: #047857;
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(4,120,87,0.25);
                }

                .field-input-wrap input::placeholder {
                    color: #64748B;
                }

                .field-input-wrap input.con-toggle {
                    padding-right: 48px;
                }

        .toggle-pass {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: none;
            border: none;
            color: #475569;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.18s, background 0.18s;
        }

            .toggle-pass:hover {
                color: #047857;
                background: rgba(4,120,87,0.08);
            }

        .caps-aviso {
            margin-top: 6px;
            font-size: 12px;
            color: #B45309;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .caps-aviso[hidden] {
                display: none;
            }

        .btn-login {
            width: 100%;
            height: 48px;
            background: #047857;
            color: #FFFFFF;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            margin-top: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.18s, transform 0.1s;
        }

            .btn-login:hover {
                background: #065F46;
            }

            .btn-login:active {
                transform: scale(0.98);
            }

            .btn-login:disabled {
                background: #065F46;
                cursor: wait;
                transform: none;
            }

            .btn-login i {
                font-size: 18px;
            }

        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #FFFFFF;
            border-radius: 50%;
            animation: girar 0.7s linear infinite;
        }

        @@keyframes girar {
            to { transform: rotate(360deg); }
        }

        .login-ayuda {
            margin: 14px 0 0;
            text-align: center;
            font-size: 13px;
            color: #475569;
        }

        .login-footer {
            background: #F8FAFC;
            border-top: 1px solid #E2E8F0;
            padding: 12px;
            text-align: center;
            font-size: 12px;
            color: #475569;
        }

            .login-footer strong {
                color: #047857;
            }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
                animation-duration: 1.5s !important;
            }

            .btn-login:active {
                transform: none;
            }
        }
    </style>
</head>
<body>

    <main class="login-card">

        <div class="login-header">
            <div class="login-logo-wrap">
                <i class="bi bi-boxes" aria-hidden="true"></i>
            </div>
            <h1>Golocentro</h1>
            <p><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Ayacucho, Perú</p>
        </div>

        <div class="login-body">
            <h2>Acceso al Sistema</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error" id="alertError" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span>@ViewBag.Error</span>
                    <button class="btn-close-error" type="button" aria-label="Cerrar mensaje"
                            onclick="document.getElementById('alertError').remove()">
                        <i class="bi bi-x" aria-hidden="true"></i>
                    </button>
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Login" id="formLogin">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="field-group">
                    <label for="nombreUsuario">Usuario</label>
                    <div class="field-input-wrap">
                        <i class="bi bi-person field-icon" aria-hidden="true"></i>
                        <input type="text"
                               id="nombreUsuario"
                               name="nombreUsuario"
                               value="@usuarioPrevio"
                               placeholder="Ingresa tu usuario"
                               required
                               autocapitalize="none"
                               spellcheck="false"
                               autocomplete="username"
                               autofocus="@string.IsNullOrEmpty(usuarioPrevio)" />
                    </div>
                </div>

                <div class="field-group">
                    <label for="contraseña">Contraseña</label>
                    <div class="field-input-wrap">
                        <i class="bi bi-lock field-icon" aria-hidden="true"></i>
                        <input type="password"
                               id="contraseña"
                               name="contraseña"
                               class="con-toggle"
                               placeholder="••••••••"
                               required
                               autocomplete="current-password"
                               autofocus="@(!string.IsNullOrEmpty(usuarioPrevio))" />
                        <button type="button" class="toggle-pass" id="togglePass"
                                aria-label="Mostrar contraseña" aria-pressed="false" aria-controls="contraseña">
                            <i class="bi bi-eye" id="toggleIcon" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="caps-aviso" id="capsAviso" aria-live="polite" hidden>
                        <i class="bi bi-capslock-fill" aria-hidden="true"></i>
                        Bloq Mayús está activado
                    </p>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    <span>Ingresar al Sistema</span>
                </button>
                <p class="login-ayuda">¿No tienes cuenta u olvidaste tu contraseña? Pídesela a la dueña.</p>
            </form>
        </div>

        <div class="login-footer">
            © @DateTime.Now.Year <strong>Distribuidora Golocentro</strong> · Todos los derechos reservados
        </div>

    </main>

    <script>
        const inputPass = document.getElementById('contraseña');
        const btnToggle = document.getElementById('togglePass');
        const iconToggle = document.getElementById('toggleIcon');
        const capsAviso = document.getElementById('capsAviso');
        const form = document.getElementById('formLogin');
        const btnLogin = document.getElementById('btnLogin');
        const contenidoBoton = btnLogin.innerHTML;

        btnToggle.addEventListener('click', function () {
            const visible = inputPass.type === 'password';
            inputPass.type = visible ? 'text' : 'password';
            iconToggle.className = visible ? 'bi bi-eye-slash' : 'bi bi-eye';
            btnToggle.setAttribute('aria-pressed', String(visible));
        });

        function revisarBloqMayus(e) {
            if (typeof e.getModifierState !== 'function') return;
            capsAviso.hidden = !e.getModifierState('CapsLock');
        }
        inputPass.addEventListener('keydown', revisarBloqMayus);
        inputPass.addEventListener('keyup', revisarBloqMayus);
        inputPass.addEventListener('blur', () => capsAviso.hidden = true);

        form.addEventListener('submit', function () {
            btnLogin.disabled = true;
            btnLogin.setAttribute('aria-busy', 'true');
            btnLogin.innerHTML = '<span class="spinner" aria-hidden="true"></span><span>Ingresando…</span>';
        });

        // Si el navegador restaura la página con "Atrás", el botón no debe quedar bloqueado
        window.addEventListener('pageshow', function () {
            btnLogin.disabled = false;
            btnLogin.removeAttribute('aria-busy');
            btnLogin.innerHTML = contenidoBoton;
        });
    </script>

</body>
</html>
