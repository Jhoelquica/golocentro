@model GestionAlmacen_Golocentro.Models.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
    var initials = string.Concat((Model.Nombre ?? "").Split(' ')
                    .Where(w => w.Length > 0).Take(2)
                    .Select(w => w[0].ToString().ToUpper()));
    var sedeNombre = Model.IdSedeNavigation?.Nombre ?? "Todas las sedes";
    var rolEtiqueta = RolHelper.Etiqueta(Model.Rol);
}

<style>
    .perfil-wrap {
        max-width: 560px;
        margin: 2rem auto;
    }

    .perfil-alert {
        border-radius: var(--radius);
        padding: 10px 14px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1rem;
        background: rgba(4,120,87,0.1);
        border: 1px solid rgba(4,120,87,0.25);
        color: var(--g-teal);
    }

    .perfil-card {
        background: var(--g-white);
        border: 1px solid var(--g-border);
        border-radius: 14px;
        overflow: hidden;
    }

    .perfil-header {
        background: var(--g-navy);
        padding: 2rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .perfil-avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .perfil-avatar,
    .perfil-avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 3px solid var(--g-sage);
    }

    .perfil-avatar {
        object-fit: cover;
    }

    .perfil-avatar-placeholder {
        background: var(--g-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 600;
        color: #FFFFFF;
    }

    .perfil-avatar-edit {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 30px;
        height: 30px;
        background: var(--g-sage);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 2px solid var(--g-navy);
        transition: background var(--transition);
    }

        .perfil-avatar-edit:hover {
            background: #FFFFFF;
        }

        /* Sobre el encabezado oscuro el verde de foco normal no se ve (1.9:1) */
        .perfil-avatar-edit:focus-visible {
            outline: 2px solid var(--g-focus-dark);
            outline-offset: 2px;
        }

        .perfil-avatar-edit i {
            font-size: 13px;
            color: var(--g-navy);
        }

    .perfil-header-info {
        min-width: 0;
    }

        .perfil-header-info h1 {
            font-size: 19px;
            font-weight: 600;
            color: #FFFFFF;
            margin-bottom: 4px;
        }

        .perfil-header-info .rol-badge {
            display: inline-block;
            background: rgba(4,120,87,0.6);
            color: var(--g-sage);
            font-size: 12px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
        }

        .perfil-header-info .sede-text {
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

    .perfil-body {
        padding: 0.5rem 1.5rem;
    }

    .perfil-field {
        display: flex;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--g-border);
        gap: 12px;
    }

        .perfil-field:last-child {
            border-bottom: none;
        }

    .perfil-field-icon {
        width: 36px;
        height: 36px;
        background: rgba(4,120,87,0.08);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .perfil-field-icon i {
            font-size: 16px;
            color: var(--g-teal);
        }

    .perfil-field-label {
        font-size: 12px;
        color: var(--g-muted);
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .perfil-field-value {
        font-size: 15px;
        font-weight: 500;
        color: var(--g-text);
    }

    .estado {
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .estado.activo {
            color: var(--g-teal);
        }

        .estado.inactivo {
            color: var(--g-danger);
        }

        .estado i {
            font-size: 8px;
        }

    .perfil-actions {
        padding: 0.5rem 1.5rem 1.5rem;
        display: flex;
        gap: 10px;
    }

    .btn-g-primary,
    .btn-g-outline {
        flex: 1;
        min-height: 44px;
        padding: 10px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        font-family: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: background var(--transition), color var(--transition);
    }

    .btn-g-primary {
        background: var(--g-teal);
        color: #FFFFFF;
        border: none;
    }

        .btn-g-primary:hover {
            background: #065F46;
            color: #FFFFFF;
        }

    .btn-g-outline {
        background: transparent;
        color: var(--g-teal);
        border: 1px solid var(--g-teal);
    }

        .btn-g-outline:hover {
            background: var(--g-teal);
            color: #FFFFFF;
        }

        .btn-g-primary:focus-visible,
        .btn-g-outline:focus-visible {
            outline: 2px solid var(--g-teal);
            outline-offset: 2px;
        }

    @@media (max-width: 420px) {
        .perfil-header {
            flex-direction: column;
            text-align: center;
        }

        .perfil-header-info .sede-text {
            justify-content: center;
        }

        .perfil-actions {
            flex-direction: column;
        }
    }
</style>

<div class="perfil-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="perfil-alert" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i> @TempData["Success"]
        </div>
    }

    <div class="perfil-card">

        <div class="perfil-header">
            <div class="perfil-avatar-wrap">
                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <img src="@Url.Content("~/uploads/perfiles/" + Model.FotoUrl)"
                         alt="Foto de perfil de @Model.Nombre" class="perfil-avatar" />
                }
                else
                {
                    <div class="perfil-avatar-placeholder" aria-hidden="true">@initials</div>
                }
                <a href="@Url.Action("CambiarFoto", "Account")" class="perfil-avatar-edit"
                   aria-label="Cambiar foto de perfil" title="Cambiar foto de perfil">
                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                </a>
            </div>
            <div class="perfil-header-info">
                <h1>@Model.Nombre</h1>
                <span class="rol-badge">@rolEtiqueta</span>
                <div class="sede-text">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    @sedeNombre
                </div>
            </div>
        </div>

        <div class="perfil-body">
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-person" aria-hidden="true"></i></div>
                <div>
                    <div class="perfil-field-label">Nombre de usuario</div>
                    <div class="perfil-field-value">@Model.Usuario1</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></div>
                <div>
                    <div class="perfil-field-label">Miembro desde</div>
                    <div class="perfil-field-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
                <div>
                    <div class="perfil-field-label">Rol</div>
                    <div class="perfil-field-value">@rolEtiqueta</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-building" aria-hidden="true"></i></div>
                <div>
                    <div class="perfil-field-label">Sede asignada</div>
                    <div class="perfil-field-value">@sedeNombre</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-toggle-on" aria-hidden="true"></i></div>
                <div>
                    <div class="perfil-field-label">Estado</div>
                    <div class="perfil-field-value">
                        @if (Model.Estado == "activo")
                        {
                            <span class="estado activo"><i class="bi bi-circle-fill" aria-hidden="true"></i>Activo</span>
                        }
                        else
                        {
                            <span class="estado inactivo"><i class="bi bi-circle-fill" aria-hidden="true"></i>Inactivo</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="perfil-actions">
            <a href="@Url.Action("CambiarFoto", "Account")" class="btn-g-primary">
                <i class="bi bi-camera" aria-hidden="true"></i> Cambiar foto
            </a>
            <a href="@Url.Action("CambiarContrasena", "Account")" class="btn-g-outline">
                <i class="bi bi-shield-lock" aria-hidden="true"></i> Cambiar contraseña
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn-g-outline">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
            </a>
        </div>

    </div>
</div>
