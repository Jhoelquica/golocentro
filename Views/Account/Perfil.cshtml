@model GestionAlmacen_Golocentro.Models.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
    var initials = string.Concat((Model.Nombre ?? "").Split(' ')
                    .Where(w => w.Length > 0).Take(2)
                    .Select(w => w[0].ToString().ToUpper()));
    var sedeNombre = Model.IdSedeNavigation?.Nombre ?? "Todas las sedes";
}

<style>
    .perfil-wrap {
        max-width: 560px;
        margin: 2rem auto;
    }

    .perfil-card {
        background: #fff;
        border: 1px solid rgba(230,232,234,0.2);
        border-radius: 14px;
        overflow: hidden;
    }
    /* Header con fondo primary */
    .perfil-header {
        background: #334155;
        padding: 2rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .perfil-avatar-wrap {
        position: relative;
    }

    .perfil-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #CBD5E1;
    }

    .perfil-avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #047857;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 600;
        color: #FFFFFF;
        border: 3px solid #CBD5E1;
    }

    .perfil-avatar-edit {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 26px;
        height: 26px;
        background: #CBD5E1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 2px solid #334155;
    }

        .perfil-avatar-edit i {
            font-size: 12px;
            color: #334155;
        }

    .perfil-header-info h4 {
        font-size: 18px;
        font-weight: 600;
        color: #FFFFFF;
        margin-bottom: 2px;
    }

    .perfil-header-info .rol-badge {
        display: inline-block;
        background: rgba(4,120,87,0.6);
        color: #CBD5E1;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        text-transform: capitalize;
    }

    .perfil-header-info .sede-text {
        font-size: 12px;
        color: rgba(255,255,255,0.6);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Body */
    .perfil-body {
        padding: 1.5rem;
    }

    .perfil-field {
        display: flex;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid rgba(230,232,234,0.15);
        gap: 12px;
    }

        .perfil-field:last-child {
            border-bottom: none;
        }

    .perfil-field-icon {
        width: 32px;
        height: 32px;
        background: rgba(4,120,87,0.08);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .perfil-field-icon i {
            font-size: 15px;
            color: #047857;
        }

    .perfil-field-info {
        flex: 1;
    }

    .perfil-field-label {
        font-size: 11px;
        color: #475569;
        font-weight: 500;
        letter-spacing: 0.04em;
        margin-bottom: 2px;
    }

    .perfil-field-value {
        font-size: 14px;
        font-weight: 500;
        color: #0F172A;
    }

    /* Acciones */
    .perfil-actions {
        padding: 0 1.5rem 1.5rem;
        display: flex;
        gap: 10px;
    }

    .btn-g-primary {
        flex: 1;
        padding: 10px;
        background: #047857;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: background 0.18s;
    }

        .btn-g-primary:hover {
            background: #065F46;
            color: #FFFFFF;
        }

    .btn-g-outline {
        flex: 1;
        padding: 10px;
        background: transparent;
        color: #047857;
        border: 1px solid #047857;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.18s;
    }

        .btn-g-outline:hover {
            background: #047857;
            color: #FFFFFF;
        }
</style>

<div class="perfil-wrap">
    <div class="perfil-card">

        <!-- Header -->
        <div class="perfil-header">
            <div class="perfil-avatar-wrap">
                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <img src="@Url.Content("~/uploads/perfiles/" + Model.FotoUrl)"
                         alt="Foto de perfil" class="perfil-avatar" />
                }
                else
                {
                    <div class="perfil-avatar-placeholder">@initials</div>
                }
                <a href="@Url.Action("CambiarFoto", "Account")" class="perfil-avatar-edit"
                   title="Cambiar foto">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            </div>
            <div class="perfil-header-info">
                <h4>@Model.Nombre</h4>
                <span class="rol-badge">@Model.Rol</span>
                <div class="sede-text">
                    <i class="bi bi-geo-alt-fill"></i>
                    @sedeNombre
                </div>
            </div>
        </div>

        <!-- Campos -->
        <div class="perfil-body">
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-person"></i></div>
                <div class="perfil-field-info">
                    <div class="perfil-field-label">NOMBRE DE USUARIO</div>
                    <div class="perfil-field-value">@Model.Usuario1</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-person-vcard"></i></div>
                <div class="perfil-field-info">
                    <div class="perfil-field-label">MIEMBRO DESDE</div>
                    <div class="perfil-field-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-shield-check"></i></div>
                <div class="perfil-field-info">
                    <div class="perfil-field-label">ROL</div>
                    <div class="perfil-field-value" style="text-transform:capitalize">@Model.Rol</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-building"></i></div>
                <div class="perfil-field-info">
                    <div class="perfil-field-label">SEDE ASIGNADA</div>
                    <div class="perfil-field-value">@sedeNombre</div>
                </div>
            </div>
            <div class="perfil-field">
                <div class="perfil-field-icon"><i class="bi bi-toggle-on"></i></div>
                <div class="perfil-field-info">
                    <div class="perfil-field-label">ESTADO</div>
                    <div class="perfil-field-value">
                        @if (Model.Estado == "activo")
                        {
                            <span style="color:#047857; font-weight:600">
                                <i class="bi bi-circle-fill" style="font-size:8px;margin-right:4px"></i>Activo
                            </span>
                        }
                        else
                        {
                            <span style="color:#DC2626; font-weight:600">
                                <i class="bi bi-circle-fill" style="font-size:8px;margin-right:4px"></i>Inactivo
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones -->
        <div class="perfil-actions">
            <a href="@Url.Action("CambiarFoto", "Account")" class="btn-g-primary">
                <i class="bi bi-camera"></i> Cambiar Foto
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn-g-outline">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

    </div>
</div>
