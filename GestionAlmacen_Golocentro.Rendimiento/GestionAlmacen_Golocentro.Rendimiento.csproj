<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta de medición de rendimiento (apartado 2.3). No es parte del sistema ni de las pruebas:
       levanta su propio PostgreSQL 18 desechable con Database/esquema.sql y nunca toca golocentro_pg.
       Uso: ver README.md de esta carpeta (pasos inventario, auditoria, volumen, medir e indice). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- La misma versión de Entity Framework que usa el sistema -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.26" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\GestionAlmacen_Golocentro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Database\esquema.sql" Link="Database\esquema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Database\2026-10-02_indice_detalle_movimiento.sql" Link="Database\2026-10-02_indice_detalle_movimiento.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
