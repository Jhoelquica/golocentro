# Servicio systemd para Golocentro (ASP.NET Core 8, publicado self-contained)
# Copiar a: /etc/systemd/system/golocentro.service
[Unit]
Description=Golocentro - Gestion de Almacen (ASP.NET Core)
After=network.target postgresql.service

[Service]
# La app arma rutas con Directory.GetCurrentDirectory(): debe arrancar en su carpeta
WorkingDirectory=/var/www/golocentro
ExecStart=/var/www/golocentro/GestionAlmacen_Golocentro
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=golocentro
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
# Solo escucha en local; Nginx es quien atiende desde internet
Environment=ASPNETCORE_URLS=http://127.0.0.1:5050
# La app usa DateTime.Now: sin esto las fechas saldrían en hora UTC (5 horas adelantadas)
Environment=TZ=America/Lima
Environment=DOTNET_NOLOGO=true
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=true

[Install]
WantedBy=multi-user.target
